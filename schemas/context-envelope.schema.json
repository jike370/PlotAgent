{
  "$defs": {
    "ChartCapabilities": {
      "additionalProperties": false,
      "properties": {
        "allowed_action_types": {
          "items": {
            "enum": [
              "create_plot",
              "patch_plot",
              "create_batch",
              "patch_batch",
              "create_figure",
              "patch_figure",
              "export_artifact"
            ],
            "type": "string"
          },
          "title": "Allowed Action Types",
          "type": "array"
        },
        "allowed_chart_type_ids": {
          "default": [],
          "items": {
            "enum": [
              "K01",
              "K02",
              "K03",
              "K04",
              "K05",
              "K06",
              "K07",
              "K08",
              "K09",
              "K10",
              "K11",
              "K12",
              "K13",
              "K14",
              "K15",
              "K16",
              "K17",
              "K18",
              "K19",
              "K20",
              "K21",
              "K22",
              "K24",
              "K25",
              "S01",
              "S05",
              "S21",
              "S25",
              "S31",
              "S34",
              "S61"
            ],
            "type": "string"
          },
          "title": "Allowed Chart Type Ids",
          "type": "array"
        },
        "allowed_patch_operations": {
          "default": [],
          "items": {
            "enum": [
              "set_axis_range",
              "set_axis_scale",
              "set_axis_label",
              "set_series_style",
              "set_legend_visibility",
              "move_legend",
              "apply_publication_profile",
              "set_canvas_size"
            ],
            "type": "string"
          },
          "title": "Allowed Patch Operations",
          "type": "array"
        },
        "capability_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Capability Version",
          "type": "string"
        },
        "export_formats": {
          "default": [],
          "items": {
            "enum": [
              "png",
              "svg",
              "opju"
            ],
            "type": "string"
          },
          "title": "Export Formats",
          "type": "array"
        },
        "limitation_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Limitation Ids",
          "type": "array"
        }
      },
      "required": [
        "capability_version",
        "allowed_action_types"
      ],
      "title": "ChartCapabilities",
      "type": "object"
    },
    "ContextEnvelope": {
      "additionalProperties": false,
      "properties": {
        "chart_capabilities": {
          "$ref": "#/$defs/ChartCapabilities"
        },
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Hash",
          "type": "string"
        },
        "conversation_state": {
          "$ref": "#/$defs/ConversationStateProjection"
        },
        "data_disclosure": {
          "$ref": "#/$defs/DataDisclosure"
        },
        "locale": {
          "pattern": "^[A-Za-z]{2,3}([-_][A-Za-z0-9]{2,8})*$",
          "title": "Locale",
          "type": "string"
        },
        "prompt_template_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Prompt Template Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_context": {
          "$ref": "#/$defs/SelectedContext"
        },
        "target_snapshot": {
          "$ref": "#/$defs/ContextObjectRef"
        },
        "user_instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "User Instruction",
          "type": "string"
        }
      },
      "required": [
        "prompt_template_version",
        "locale",
        "user_instruction",
        "target_snapshot",
        "conversation_state",
        "chart_capabilities",
        "selected_context",
        "data_disclosure",
        "context_hash"
      ],
      "title": "ContextEnvelope",
      "type": "object"
    },
    "ContextField": {
      "additionalProperties": false,
      "properties": {
        "field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field Alias",
          "type": "string"
        },
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "logical_type": {
          "enum": [
            "numeric",
            "categorical",
            "datetime",
            "boolean",
            "text"
          ],
          "title": "Logical Type",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "semantic_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Role"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextFieldSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit_text": {
          "default": "",
          "maxLength": 128,
          "title": "Unit Text",
          "type": "string"
        }
      },
      "required": [
        "field_alias",
        "field_id",
        "name",
        "logical_type"
      ],
      "title": "ContextField",
      "type": "object"
    },
    "ContextFieldSummary": {
      "additionalProperties": false,
      "properties": {
        "distinct_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Count"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "nan_count": {
          "default": 0,
          "minimum": 0,
          "title": "Nan Count",
          "type": "integer"
        },
        "negative_inf_count": {
          "default": 0,
          "minimum": 0,
          "title": "Negative Inf Count",
          "type": "integer"
        },
        "numeric_maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Maximum"
        },
        "numeric_minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Minimum"
        },
        "positive_inf_count": {
          "default": 0,
          "minimum": 0,
          "title": "Positive Inf Count",
          "type": "integer"
        },
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        }
      },
      "required": [
        "valid_count",
        "missing_count"
      ],
      "title": "ContextFieldSummary",
      "type": "object"
    },
    "ContextMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ContextMessage",
      "type": "object"
    },
    "ContextObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "object_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Object Alias",
          "type": "string"
        },
        "object_id": {
          "pattern": "^(source|mapping|preparation|prepared|plotcalc|plot|batch|figure|export|renderplan|originplan|plan|project):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "source_dataset",
            "prepared_dataset",
            "plot",
            "batch",
            "figure",
            "export",
            "project"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "minimum": 1,
          "title": "Object Version",
          "type": "integer"
        }
      },
      "required": [
        "object_alias",
        "object_id",
        "object_version",
        "object_type"
      ],
      "title": "ContextObjectRef",
      "type": "object"
    },
    "ContextSampleRow": {
      "additionalProperties": false,
      "properties": {
        "sample_key": {
          "pattern": "^sample:[0-9a-f]{16}$",
          "title": "Sample Key",
          "type": "string"
        },
        "values": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/NonFiniteSampleValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "sample_key",
        "values"
      ],
      "title": "ContextSampleRow",
      "type": "object"
    },
    "ConversationStateProjection": {
      "additionalProperties": false,
      "properties": {
        "confirmed_field_aliases": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Confirmed Field Aliases",
          "type": "array"
        },
        "current_target": {
          "$ref": "#/$defs/ContextObjectRef"
        },
        "project_rule_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Project Rule Ids",
          "type": "array"
        },
        "recent_result_kinds": {
          "default": [],
          "items": {
            "enum": [
              "action_plan",
              "needs_input",
              "unsupported",
              "no_change",
              "execution_result"
            ],
            "type": "string"
          },
          "title": "Recent Result Kinds",
          "type": "array"
        },
        "saved_setting_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Saved Setting Refs",
          "type": "array"
        },
        "selected_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextObjectRef"
          },
          "title": "Selected Objects",
          "type": "array"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "unresolved_question_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Unresolved Question Ids",
          "type": "array"
        }
      },
      "required": [
        "state_version",
        "current_target"
      ],
      "title": "ConversationStateProjection",
      "type": "object"
    },
    "DataDisclosure": {
      "additionalProperties": false,
      "properties": {
        "authorization_scope": {
          "enum": [
            "default_consent",
            "this_run",
            "this_conversation_similar"
          ],
          "title": "Authorization Scope",
          "type": "string"
        },
        "categories": {
          "items": {
            "enum": [
              "user_instruction",
              "field_metadata",
              "statistics",
              "sample",
              "message_window",
              "chart_capabilities"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "disclosure_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Disclosure Hash",
          "type": "string"
        },
        "field_aliases": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Field Aliases",
          "type": "array"
        },
        "field_count": {
          "minimum": 0,
          "title": "Field Count",
          "type": "integer"
        },
        "provider_config_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Provider Config Id",
          "type": "string"
        },
        "provider_type": {
          "enum": [
            "builtin",
            "custom"
          ],
          "title": "Provider Type",
          "type": "string"
        },
        "retention_disclosure_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Retention Disclosure Version",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "scalar_count": {
          "minimum": 0,
          "title": "Scalar Count",
          "type": "integer"
        }
      },
      "required": [
        "provider_type",
        "provider_config_id",
        "authorization_scope",
        "retention_disclosure_version",
        "categories",
        "field_aliases",
        "field_count",
        "row_count",
        "scalar_count",
        "disclosure_hash"
      ],
      "title": "DataDisclosure",
      "type": "object"
    },
    "NonFiniteSampleValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "nonfinite",
          "default": "nonfinite",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "enum": [
            "nan",
            "positive_inf",
            "negative_inf"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "NonFiniteSampleValue",
      "type": "object"
    },
    "SelectedContext": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextField"
          },
          "title": "Fields",
          "type": "array"
        },
        "message_window": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextMessage"
          },
          "title": "Message Window",
          "type": "array"
        },
        "sample_rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextSampleRow"
          },
          "title": "Sample Rows",
          "type": "array"
        },
        "selected_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextObjectRef"
          },
          "title": "Selected Objects",
          "type": "array"
        }
      },
      "title": "SelectedContext",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/context-envelope.schema.json",
  "$ref": "#/$defs/ContextEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextEnvelopeContract"
}
