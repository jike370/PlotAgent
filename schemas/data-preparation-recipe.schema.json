{
  "$defs": {
    "DataPreparationMatchContract": {
      "additionalProperties": false,
      "description": "Strict structural preconditions; never natural-language intent.",
      "properties": {
        "parser_contract_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Contract Version",
          "type": "string"
        },
        "required_marker_hashes": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Required Marker Hashes",
          "type": "array"
        },
        "source_formats": {
          "items": {
            "enum": [
              "csv",
              "tsv",
              "txt",
              "dat",
              "xlsx",
              "xlsm",
              "xls"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Formats",
          "type": "array"
        },
        "specificity": {
          "default": 500,
          "maximum": 1000,
          "minimum": 1,
          "title": "Specificity",
          "type": "integer"
        },
        "table_count": {
          "minimum": 1,
          "title": "Table Count",
          "type": "integer"
        },
        "table_structure_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Table Structure Hashes",
          "type": "array"
        }
      },
      "required": [
        "source_formats",
        "table_count",
        "table_structure_hashes",
        "parser_contract_version"
      ],
      "title": "DataPreparationMatchContract",
      "type": "object"
    },
    "DataPreparationOutputContract": {
      "additionalProperties": false,
      "properties": {
        "allow_additional_tables": {
          "const": false,
          "default": false,
          "title": "Allow Additional Tables",
          "type": "boolean"
        },
        "preserve_source_coordinates": {
          "const": true,
          "default": true,
          "title": "Preserve Source Coordinates",
          "type": "boolean"
        },
        "preserve_source_order": {
          "const": true,
          "default": true,
          "title": "Preserve Source Order",
          "type": "boolean"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/DataPreparationTableContract"
          },
          "minItems": 1,
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "tables"
      ],
      "title": "DataPreparationOutputContract",
      "type": "object"
    },
    "DataPreparationTableContract": {
      "additionalProperties": false,
      "properties": {
        "column_names": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Column Names",
          "type": "array"
        },
        "logical_types": {
          "items": {
            "enum": [
              "numeric",
              "categorical",
              "datetime",
              "boolean",
              "text"
            ],
            "type": "string"
          },
          "title": "Logical Types",
          "type": "array"
        },
        "minimum_rows": {
          "minimum": 0,
          "title": "Minimum Rows",
          "type": "integer"
        },
        "structure_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Structure Hash",
          "type": "string"
        },
        "table_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Table Key",
          "type": "string"
        },
        "unit_labels": {
          "items": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Unit Labels",
          "type": "array"
        }
      },
      "required": [
        "table_key",
        "column_names",
        "logical_types",
        "unit_labels",
        "minimum_rows",
        "structure_hash"
      ],
      "title": "DataPreparationTableContract",
      "type": "object"
    },
    "ParseSourceStep": {
      "additionalProperties": false,
      "description": "The bounded parser choice proven by a successful preparation run.",
      "properties": {
        "decimal_mark": {
          "anyOf": [
            {
              "enum": [
                ".",
                ","
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimal Mark"
        },
        "delimiter": {
          "anyOf": [
            {
              "maxLength": 4,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "encoding": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "header_row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Row"
        },
        "operation": {
          "const": "parse_source",
          "default": "parse_source",
          "title": "Operation",
          "type": "string"
        },
        "sheet": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "source_format": {
          "enum": [
            "csv",
            "tsv",
            "txt",
            "dat",
            "xlsx",
            "xlsm",
            "xls"
          ],
          "title": "Source Format",
          "type": "string"
        }
      },
      "required": [
        "source_format"
      ],
      "title": "ParseSourceStep",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v2/data-preparation-recipe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_from_run_id": {
      "pattern": "^data-run:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Created From Run Id",
      "type": "string"
    },
    "created_from_source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Created From Source Hash",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "match_contract": {
      "$ref": "#/$defs/DataPreparationMatchContract"
    },
    "output_contract": {
      "$ref": "#/$defs/DataPreparationOutputContract"
    },
    "recipe_id": {
      "pattern": "^data-recipe:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_version": {
      "minimum": 1,
      "title": "Recipe Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "data-preparation-recipe.v1",
      "default": "data-preparation-recipe.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "personal",
      "enum": [
        "personal",
        "project"
      ],
      "title": "Scope",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ParseSourceStep"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "recipe_id",
    "recipe_version",
    "display_name",
    "match_contract",
    "steps",
    "output_contract",
    "created_from_run_id",
    "created_from_source_hash"
  ],
  "title": "DataPreparationRecipe",
  "type": "object"
}
