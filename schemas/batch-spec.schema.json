{
  "$defs": {
    "AddAnnotationPatch": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationSpec"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "annotation"
      ],
      "title": "AddAnnotationPatch",
      "type": "object"
    },
    "AnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
        },
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "AnnotationSpec",
      "type": "object"
    },
    "ApplyPublicationProfilePatch": {
      "additionalProperties": false,
      "properties": {
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "apply_publication_profile",
          "default": "apply_publication_profile",
          "title": "Operation",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/PublicationProfileSnapshot"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "profile"
      ],
      "title": "ApplyPublicationProfilePatch",
      "type": "object"
    },
    "BatchExecutionSignature": {
      "additionalProperties": false,
      "description": "Source-independent identity for one strictly isomorphic batch fan-out.",
      "properties": {
        "chart_type_id": {
          "enum": [
            "K01",
            "K02",
            "K03",
            "K04",
            "K05",
            "K06",
            "K07",
            "K08",
            "K09",
            "K10",
            "K11",
            "K12",
            "K13",
            "K14",
            "K15",
            "K16",
            "K17",
            "K18",
            "K19",
            "K20",
            "K21",
            "K22",
            "K24",
            "K25",
            "S01",
            "S05",
            "S21",
            "S25",
            "S31",
            "S34",
            "S61",
            "X01",
            "X02",
            "X03",
            "X05",
            "X07",
            "X09",
            "X11",
            "X12",
            "X13",
            "X15",
            "X16",
            "X17",
            "X18",
            "X19",
            "X23",
            "X24",
            "X35",
            "X36",
            "X37",
            "X38",
            "S07"
          ],
          "title": "Chart Type Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_signature": {
          "$ref": "#/$defs/DatasetSignature"
        },
        "field_mapping_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Field Mapping Hash",
          "type": "string"
        },
        "plot_calculation_spec_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot Calculation Spec Hash"
        },
        "plot_template_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plot Template Hash",
          "type": "string"
        },
        "preparation_spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preparation Spec Hash",
          "type": "string"
        },
        "style_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Style Hash",
          "type": "string"
        }
      },
      "required": [
        "dataset_signature",
        "field_mapping_hash",
        "preparation_spec_hash",
        "chart_type_id",
        "plot_template_hash",
        "style_hash",
        "content_hash"
      ],
      "title": "BatchExecutionSignature",
      "type": "object"
    },
    "BatchItemState": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "plot_version_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlotSpecRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_state": {
          "default": "unconfirmed",
          "enum": [
            "unconfirmed",
            "confirmed",
            "excluded"
          ],
          "title": "Review State",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "queued",
            "preparing",
            "running",
            "committing",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "state"
      ],
      "title": "BatchItemState",
      "type": "object"
    },
    "BatchPlotOverride": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "patches": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "add_annotation": "#/$defs/AddAnnotationPatch",
                "apply_publication_profile": "#/$defs/ApplyPublicationProfilePatch",
                "move_legend": "#/$defs/MoveLegendPatch",
                "remove_annotation": "#/$defs/RemoveAnnotationPatch",
                "set_axis_label": "#/$defs/SetAxisLabelPatch",
                "set_axis_range": "#/$defs/SetAxisRangePatch",
                "set_axis_scale": "#/$defs/SetAxisScalePatch",
                "set_batch_axis_policy": "#/$defs/SetBatchAxisPolicyPatch",
                "set_canvas_size": "#/$defs/SetCanvasSizePatch",
                "set_category_color": "#/$defs/SetCategoryColorPatch",
                "set_legend_visibility": "#/$defs/SetLegendVisibilityPatch",
                "set_palette": "#/$defs/SetPalettePatch",
                "set_series_style": "#/$defs/SetSeriesStylePatch",
                "update_annotation": "#/$defs/UpdateAnnotationPatch"
              },
              "propertyName": "operation"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SetAxisRangePatch"
              },
              {
                "$ref": "#/$defs/SetAxisScalePatch"
              },
              {
                "$ref": "#/$defs/SetAxisLabelPatch"
              },
              {
                "$ref": "#/$defs/SetSeriesStylePatch"
              },
              {
                "$ref": "#/$defs/SetPalettePatch"
              },
              {
                "$ref": "#/$defs/SetCategoryColorPatch"
              },
              {
                "$ref": "#/$defs/MoveLegendPatch"
              },
              {
                "$ref": "#/$defs/SetLegendVisibilityPatch"
              },
              {
                "$ref": "#/$defs/AddAnnotationPatch"
              },
              {
                "$ref": "#/$defs/UpdateAnnotationPatch"
              },
              {
                "$ref": "#/$defs/RemoveAnnotationPatch"
              },
              {
                "$ref": "#/$defs/ApplyPublicationProfilePatch"
              },
              {
                "$ref": "#/$defs/SetCanvasSizePatch"
              },
              {
                "$ref": "#/$defs/SetBatchAxisPolicyPatch"
              }
            ]
          },
          "title": "Patches",
          "type": "array"
        },
        "prepared_dataset_ref": {
          "$ref": "#/$defs/PreparedDatasetRef"
        }
      },
      "required": [
        "item_id",
        "prepared_dataset_ref"
      ],
      "title": "BatchPlotOverride",
      "type": "object"
    },
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
    "DatasetFieldSignature": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "logical_type": {
          "enum": [
            "numeric",
            "categorical",
            "datetime",
            "boolean",
            "text"
          ],
          "title": "Logical Type",
          "type": "string"
        },
        "semantic_role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Semantic Role",
          "type": "string"
        },
        "unit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Unit Hash",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "logical_type",
        "unit_hash",
        "semantic_role"
      ],
      "title": "DatasetFieldSignature",
      "type": "object"
    },
    "DatasetSignature": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/DatasetFieldSignature"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "semantic_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Hash",
          "type": "string"
        }
      },
      "required": [
        "fields",
        "semantic_hash"
      ],
      "title": "DatasetSignature",
      "type": "object"
    },
    "FieldMappingRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "field_mapping_id": {
          "pattern": "^mapping:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Mapping Id",
          "type": "string"
        },
        "mapping_version": {
          "minimum": 1,
          "title": "Mapping Version",
          "type": "integer"
        }
      },
      "required": [
        "field_mapping_id",
        "mapping_version",
        "content_hash"
      ],
      "title": "FieldMappingRef",
      "type": "object"
    },
    "MoveLegendPatch": {
      "additionalProperties": false,
      "properties": {
        "anchor_x": {
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Y",
          "type": "number"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "move_legend",
          "default": "move_legend",
          "title": "Operation",
          "type": "string"
        },
        "placement": {
          "enum": [
            "inside",
            "outside_right",
            "outside_bottom"
          ],
          "title": "Placement",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "placement",
        "anchor_x",
        "anchor_y"
      ],
      "title": "MoveLegendPatch",
      "type": "object"
    },
    "PhysicalLength": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "pt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "PhysicalLength",
      "type": "object"
    },
    "PhysicalSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "width": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "PhysicalSize",
      "type": "object"
    },
    "PlotCalculationSpecRef": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "pattern": "^plotcalc:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Calculation Id",
          "type": "string"
        },
        "calculation_kind": {
          "enum": [
            "histogram_binning",
            "tukey_box",
            "violin_kde",
            "density_kde",
            "ecdf",
            "summary_error",
            "percent_stack",
            "matrix_projection",
            "confusion_count"
          ],
          "title": "Calculation Kind",
          "type": "string"
        },
        "calculation_version": {
          "minimum": 1,
          "title": "Calculation Version",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "calculation_id",
        "calculation_version",
        "calculation_kind",
        "content_hash"
      ],
      "title": "PlotCalculationSpecRef",
      "type": "object"
    },
    "PlotSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "plot_id": {
          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "plot_version": {
          "minimum": 1,
          "title": "Plot Version",
          "type": "integer"
        }
      },
      "required": [
        "plot_id",
        "plot_version",
        "content_hash"
      ],
      "title": "PlotSpecRef",
      "type": "object"
    },
    "PreparationSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "preparation_spec_id": {
          "pattern": "^preparation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Preparation Spec Id",
          "type": "string"
        },
        "preparation_version": {
          "minimum": 1,
          "title": "Preparation Version",
          "type": "integer"
        }
      },
      "required": [
        "preparation_spec_id",
        "preparation_version",
        "content_hash"
      ],
      "title": "PreparationSpecRef",
      "type": "object"
    },
    "PreparedDatasetRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "prepared_dataset_id": {
          "pattern": "^prepared:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Prepared Dataset Id",
          "type": "string"
        },
        "prepared_version": {
          "minimum": 1,
          "title": "Prepared Version",
          "type": "integer"
        }
      },
      "required": [
        "prepared_dataset_id",
        "prepared_version",
        "content_hash"
      ],
      "title": "PreparedDatasetRef",
      "type": "object"
    },
    "PublicationProfileSnapshot": {
      "additionalProperties": false,
      "properties": {
        "color_space": {
          "const": "sRGB",
          "default": "sRGB",
          "title": "Color Space",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dpi": {
          "maximum": 2400,
          "minimum": 72,
          "title": "Dpi",
          "type": "integer"
        },
        "physical_size": {
          "$ref": "#/$defs/PhysicalSize"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minimum": 1,
          "title": "Profile Version",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "content_hash",
        "physical_size",
        "dpi"
      ],
      "title": "PublicationProfileSnapshot",
      "type": "object"
    },
    "RemoveAnnotationPatch": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "remove_annotation",
          "default": "remove_annotation",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "annotation_id"
      ],
      "title": "RemoveAnnotationPatch",
      "type": "object"
    },
    "ResolvedStyleSnapshot": {
      "additionalProperties": false,
      "properties": {
        "colors": {
          "items": {
            "$ref": "#/$defs/ColorValue"
          },
          "minItems": 1,
          "title": "Colors",
          "type": "array"
        },
        "font_family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "font_size": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "line_width": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "marker_size": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "font_family",
        "font_size",
        "line_width",
        "marker_size",
        "colors"
      ],
      "title": "ResolvedStyleSnapshot",
      "type": "object"
    },
    "SafeRichText": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/SafeTextNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "SafeRichText",
      "type": "object"
    },
    "SafeTextNode": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "kind": {
          "enum": [
            "plain",
            "newline",
            "sub",
            "sup",
            "bold",
            "italic",
            "fraction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SafeTextNode",
      "type": "object"
    },
    "SetAxisLabelPatch": {
      "additionalProperties": false,
      "properties": {
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/SafeRichText"
        },
        "operation": {
          "const": "set_axis_label",
          "default": "set_axis_label",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
