  "$id": "https://schemas.plotagent.local/v1/batch-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axis_policy": {
      "default": "per_plot",
      "enum": [
        "per_plot",
        "unified"
      ],
      "title": "Axis Policy",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^batch:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Batch Id",
      "type": "string"
    },
    "batch_version": {
      "minimum": 1,
      "title": "Batch Version",
      "type": "integer"
    },
    "dataset_signature": {
      "$ref": "#/$defs/DatasetSignature"
    },
    "dataset_version_refs": {
      "items": {
        "$ref": "#/$defs/PreparedDatasetRef"
      },
      "minItems": 1,
      "title": "Dataset Version Refs",
      "type": "array"
    },
    "execution_signature": {
      "$ref": "#/$defs/BatchExecutionSignature"
    },
    "item_states": {
      "items": {
        "$ref": "#/$defs/BatchItemState"
      },
      "minItems": 1,
      "title": "Item States",
      "type": "array"
    },
    "plot_overrides": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BatchPlotOverride"
      },
      "title": "Plot Overrides",
      "type": "array"
    },
    "plot_template_ref": {
      "$ref": "#/$defs/PlotSpecRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_field_mapping": {
      "$ref": "#/$defs/FieldMappingRef"
    },
    "shared_plot_calculation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlotCalculationSpecRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shared_preparation": {
      "$ref": "#/$defs/PreparationSpecRef"
    },
    "shared_style": {
      "$ref": "#/$defs/ResolvedStyleSnapshot"
    }
  },
  "required": [
    "batch_id",
    "batch_version",
    "dataset_signature",
    "execution_signature",
    "dataset_version_refs",
    "shared_field_mapping",
    "shared_preparation",
    "plot_template_ref",
    "shared_style",
    "item_states"
  ],
  "title": "BatchSpec",
  "type": "object"
}
