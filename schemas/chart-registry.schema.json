{
  "$defs": {
    "ChartRegistration": {
      "additionalProperties": false,
      "properties": {
        "admission": {
          "default": "product",
          "enum": [
            "product",
            "internal_only",
            "removed"
          ],
          "title": "Admission",
          "type": "string"
        },
        "allowed_calculations": {
          "default": [],
          "items": {
            "enum": [
              "histogram_binning",
              "tukey_box",
              "violin_kde",
              "density_kde",
              "ecdf",
              "summary_error",
              "percent_stack",
              "matrix_projection",
              "confusion_count"
            ],
            "type": "string"
          },
          "title": "Allowed Calculations",
          "type": "array"
        },
        "chart_type_id": {
          "enum": [
            "K01",
            "K02",
            "K03",
            "K04",
            "K05",
            "K06",
            "K07",
            "K08",
            "K09",
            "K10",
            "K11",
            "K12",
            "K13",
            "K14",
            "K15",
            "K16",
            "K17",
            "K18",
            "K19",
            "K20",
            "K21",
            "K22",
            "K24",
            "K25",
            "S01",
            "S05",
            "S21",
            "S25",
            "S31",
            "S34",
            "S61",
            "X01",
            "X02",
            "X03",
            "X05",
            "X07",
            "X09",
            "X11",
            "X12",
            "X13",
            "X15",
            "X16",
            "X17",
            "X18",
            "X19",
            "X23",
            "X24",
            "X35",
            "X36",
            "X37",
            "X38",
            "X39",
            "X40",
            "S07"
          ],
          "title": "Chart Type Id",
          "type": "string"
        },
        "edit_capabilities": {
          "default": [],
          "items": {
            "enum": [
              "plot_title",
              "axis_label",
              "axis_range",
              "axis_scale",
              "axis_ticks",
              "font",
              "legend_visibility",
              "legend_position",
              "canvas_size",
              "publication_profile",
              "safe_annotation",
              "series_color",
              "line_width",
              "line_style",
              "marker_size",
              "symbol_shape",
              "symbol_interior",
              "palette",
              "bar_fill",
              "bar_edge",
              "bar_width",
              "bar_gap",
              "error_style",
              "band_style",
              "colorbar",
              "dual_y_style",
              "panel_style",
              "y_offset",
              "chart_parameters"
            ],
            "type": "string"
          },
          "title": "Edit Capabilities",
          "type": "array"
        },
        "english_name": {
          "title": "English Name",
          "type": "string"
        },
        "exports": {
          "$ref": "#/$defs/ExportCapabilities",
          "default": {
            "opju": "O1",
            "png": true,
            "svg": true
          }
        },
        "family": {
          "enum": [
            "xy",
            "categorical",
            "distribution",
            "matrix",
            "survival",
            "dose_response",
            "forest",
            "facet",
            "special"
          ],
          "title": "Family",
          "type": "string"
        },
        "geometries": {
          "items": {
            "enum": [
              "line",
              "symbol",
              "error_bar",
              "band",
              "area",
              "bar",
              "strip",
              "box",
              "violin",
              "histogram",
              "density",
              "step",
              "heatmap",
              "contour",
              "risk_table",
              "interval",
              "panel",
              "drop_line",
              "lollipop",
              "line_series",
              "before_after",
              "beeswarm",
              "ridgeline",
              "floating_bar",
              "bridge",
              "bullet",
              "pyramid",
              "scatter_matrix",
              "density2d",
              "marginal",
              "probability",
              "agreement",
              "dual_axis",
              "y_offset",
              "volcano"
            ],
            "type": "string"
          },
          "title": "Geometries",
          "type": "array"
        },
        "optional_roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Optional Roles",
          "type": "array"
        },
        "required_calculations": {
          "default": [],
          "items": {
            "enum": [
              "histogram_binning",
              "tukey_box",
              "violin_kde",
              "density_kde",
              "ecdf",
              "summary_error",
              "percent_stack",
              "matrix_projection",
              "confusion_count"
            ],
            "type": "string"
          },
          "title": "Required Calculations",
          "type": "array"
        },
        "required_precomputed": {
          "default": [],
          "items": {
            "enum": [
              "curve",
              "band",
              "matrix",
              "matrix_grid",
              "step_curve",
              "risk_table",
              "parameter_table",
              "spectrum",
              "peak_labels",
              "complex_curve",
              "effect_interval"
            ],
            "type": "string"
          },
          "title": "Required Precomputed",
          "type": "array"
        },
        "required_roles": {
          "items": {
            "type": "string"
          },
          "title": "Required Roles",
          "type": "array"
        },
        "unsupported_edit_capabilities": {
          "default": [],
          "items": {
            "enum": [
              "plot_title",
              "axis_label",
              "axis_range",
              "axis_scale",
              "axis_ticks",
              "font",
              "legend_visibility",
              "legend_position",
              "canvas_size",
              "publication_profile",
              "safe_annotation",
              "series_color",
              "line_width",
              "line_style",
              "marker_size",
              "symbol_shape",
              "symbol_interior",
              "palette",
              "bar_fill",
              "bar_edge",
              "bar_width",
              "bar_gap",
              "error_style",
              "band_style",
              "colorbar",
              "dual_y_style",
              "panel_style",
              "y_offset",
              "chart_parameters"
            ],
            "type": "string"
          },
          "title": "Unsupported Edit Capabilities",
          "type": "array"
        },
        "visual_evidence": {
          "default": "origin_reference",
          "enum": [
            "origin_reference",
            "synthetic_visual",
            "unqualified"
          ],
          "title": "Visual Evidence",
          "type": "string"
        }
      },
      "required": [
        "chart_type_id",
        "english_name",
        "family",
        "geometries",
        "required_roles"
      ],
      "title": "ChartRegistration",
      "type": "object"
    },
    "ExportCapabilities": {
      "additionalProperties": false,
      "properties": {
        "opju": {
          "default": "O1",
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3"
          ],
          "title": "Opju",
          "type": "string"
        },
        "png": {
          "const": true,
          "default": true,
          "title": "Png",
          "type": "boolean"
        },
        "svg": {
          "const": true,
          "default": true,
          "title": "Svg",
          "type": "boolean"
        }
      },
      "title": "ExportCapabilities",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/chart-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "charts": {
      "items": {
        "$ref": "#/$defs/ChartRegistration"
      },
      "minItems": 1,
      "title": "Charts",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "charts"
  ],
  "title": "ChartRegistry",
  "type": "object"
}
