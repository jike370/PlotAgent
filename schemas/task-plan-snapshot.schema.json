            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "item_id": {
          "pattern": "^item:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "output_plot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
