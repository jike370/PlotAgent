  "$id": "https://schemas.plotagent.local/v2/task-plan-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "current_project_revision": {
      "minimum": 0,
      "title": "Current Project Revision",
      "type": "integer"
    },
    "item_progress": {
      "items": {
        "$ref": "#/$defs/TaskItemProgress"
      },
