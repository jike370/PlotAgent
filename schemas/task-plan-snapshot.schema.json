    "SelectFields": {
      "additionalProperties": false,
      "properties": {
        "field_aliases": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Field Aliases",
          "type": "array"
        },
        "operation": {
          "const": "select_fields",
          "default": "select_fields",
          "title": "Operation",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        }
      },
      "required": [
        "source_alias",
        "field_aliases"
      ],
      "title": "SelectFields",
      "type": "object"
    },
    "SortKey": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "ascending",
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Direction",
          "type": "string"
        },
        "field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field Alias",
          "type": "string"
        },
        "missing": {
          "default": "last",
          "enum": [
            "first",
            "last"
          ],
          "title": "Missing",
          "type": "string"
        }
      },
      "required": [
        "field_alias"
