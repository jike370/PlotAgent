          "type": "array"
        },
        "operation": {
          "const": "sort_rows",
          "default": "sort_rows",
          "title": "Operation",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        }
      },
      "required": [
        "source_alias",
        "keys"
      ],
      "title": "SortRows",
      "type": "object"
    },
    "TaskItemProgress": {
      "additionalProperties": false,
      "properties": {
