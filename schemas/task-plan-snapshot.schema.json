        "running",
        "partially_succeeded",
        "succeeded",
        "failed",
        "rejected",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "plan",
    "state",
    "current_project_revision",
    "item_progress",
    "created_at",
    "updated_at"
  ],
  "title": "TaskPlanSnapshot",
  "type": "object"
}
