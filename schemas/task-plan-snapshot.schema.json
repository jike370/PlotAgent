          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
