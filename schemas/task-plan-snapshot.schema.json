          "maxItems": 8,
          "minItems": 1,
          "title": "Index Field Aliases",
          "type": "array"
        },
        "name_field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name Field Alias",
          "type": "string"
        },
        "operation": {
          "const": "reshape_long_to_wide",
          "default": "reshape_long_to_wide",
          "title": "Operation",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        },
        "value_field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Value Field Alias",
          "type": "string"
        }
      },
      "required": [
        "source_alias",
        "index_field_aliases",
        "name_field_alias",
        "value_field_alias"
      ],
      "title": "ReshapeLongToWide",
      "type": "object"
    },
    "ReshapeWideToLong": {
      "additionalProperties": false,
      "properties": {
        "id_field_aliases": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Id Field Aliases",
          "type": "array"
        },
        "operation": {
          "const": "reshape_wide_to_long",
          "default": "reshape_wide_to_long",
          "title": "Operation",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Output Name",
          "type": "string"
        },
        "output_value": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Output Value",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        },
        "value_field_aliases": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Value Field Aliases",
          "type": "array"
        }
      },
      "required": [
        "source_alias",
        "value_field_aliases",
        "output_name",
        "output_value"
      ],
      "title": "ReshapeWideToLong",
      "type": "object"
    },
