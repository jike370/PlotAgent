          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        }
      },
      "required": [
        "role",
        "source_alias",
