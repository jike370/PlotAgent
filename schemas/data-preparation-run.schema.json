{
  "$defs": {
    "ParseSourceStep": {
      "additionalProperties": false,
      "description": "The bounded parser choice proven by a successful preparation run.",
      "properties": {
        "decimal_mark": {
          "anyOf": [
            {
              "enum": [
                ".",
                ","
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimal Mark"
        },
        "delimiter": {
          "anyOf": [
            {
              "maxLength": 4,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "encoding": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "header_row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Row"
        },
        "operation": {
          "const": "parse_source",
          "default": "parse_source",
          "title": "Operation",
          "type": "string"
        },
        "sheet": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "source_format": {
          "enum": [
            "csv",
            "tsv",
            "txt",
            "dat",
            "xlsx",
            "xlsm",
            "xls"
          ],
          "title": "Source Format",
          "type": "string"
        }
      },
      "required": [
        "source_format"
      ],
      "title": "ParseSourceStep",
      "type": "object"
    },
    "ProbedTable": {
      "additionalProperties": false,
      "description": "Non-semantic structure facts observed for one candidate table.",
      "properties": {
        "column_count": {
          "minimum": 1,
          "title": "Column Count",
          "type": "integer"
        },
        "column_names": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Column Names",
          "type": "array"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "logical_types": {
          "items": {
            "enum": [
              "numeric",
              "categorical",
              "datetime",
              "boolean",
              "text"
            ],
            "type": "string"
          },
          "title": "Logical Types",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "structure_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Structure Hash",
          "type": "string"
        },
        "table_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Table Key",
          "type": "string"
        },
        "unit_labels": {
          "items": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Unit Labels",
          "type": "array"
        }
      },
      "required": [
        "table_key",
        "display_name",
        "row_count",
        "column_count",
        "column_names",
        "logical_types",
        "unit_labels",
        "structure_hash"
      ],
      "title": "ProbedTable",
      "type": "object"
    },
    "RecipeCandidateEvaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate_kind": {
          "enum": [
            "saved_recipe",
            "generic_parser"
          ],
          "title": "Candidate Kind",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "output_hashes": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Output Hashes",
          "type": "array"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "recipe_id": {
          "anyOf": [
            {
              "pattern": "^data-recipe:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Id"
        },
        "recipe_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Version"
        },
        "specificity": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Specificity",
          "type": "integer"
        },
        "state": {
          "enum": [
            "filtered",
            "sandbox_passed",
            "sandbox_failed",
            "selected"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "candidate_kind",
        "display_name",
        "specificity",
        "state",
        "duration_ms"
      ],
      "title": "RecipeCandidateEvaluation",
      "type": "object"
    },
    "SourceStructureProbe": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "generic_parser_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generic Parser Code"
        },
        "generic_parser_outcome": {
          "enum": [
            "imported",
            "clarification",
            "rejection"
          ],
          "title": "Generic Parser Outcome",
          "type": "string"
        },
        "marker_hashes": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Marker Hashes",
          "type": "array"
        },
        "probe_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "source-structure-probe.v1",
          "default": "source-structure-probe.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_format": {
          "enum": [
            "csv",
            "tsv",
            "txt",
            "dat",
            "xlsx",
            "xlsm",
            "xls"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "source_object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Object Hash",
          "type": "string"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProbedTable"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "source_object_hash",
        "source_format",
        "byte_size",
        "generic_parser_outcome",
        "probe_hash"
      ],
      "title": "SourceStructureProbe",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v2/data-preparation-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecipeCandidateEvaluation"
      },
      "title": "Candidates",
      "type": "array"
    },
    "created_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "executed_steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParseSourceStep"
      },
      "title": "Executed Steps",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "input_token_count": {
      "default": 0,
      "minimum": 0,
      "title": "Input Token Count",
      "type": "integer"
    },
    "local_duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Local Duration Ms",
      "type": "integer"
    },
    "model_turn_count": {
      "default": 0,
      "maximum": 8,
      "minimum": 0,
      "title": "Model Turn Count",
      "type": "integer"
    },
    "output_content_hashes": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Output Content Hashes",
      "type": "array"
    },
    "output_source_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "title": "Output Source Ids",
      "type": "array"
    },
    "output_token_count": {
      "default": 0,
      "minimum": 0,
      "title": "Output Token Count",
      "type": "integer"
    },
    "probe": {
      "$ref": "#/$defs/SourceStructureProbe"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "resource_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Resource Id",
      "type": "string"
    },
    "route": {
      "anyOf": [
        {
          "enum": [
            "generic_parser",
            "saved_recipe",
            "agent_assisted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route"
    },
    "run_id": {
      "pattern": "^data-run:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "data-preparation-run.v1",
      "default": "data-preparation-run.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_recipe_id": {
      "anyOf": [
        {
          "pattern": "^data-recipe:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Recipe Id"
    },
    "selected_recipe_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Recipe Version"
    },
    "source_object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Object Hash",
      "type": "string"
    },
    "state": {
      "enum": [
        "probing",
        "matching",
        "awaiting_recipe_selection",
        "agent_required",
        "validating",
        "awaiting_confirmation",
        "committed",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "tool_call_count": {
      "default": 0,
      "maximum": 32,
      "minimum": 0,
      "title": "Tool Call Count",
      "type": "integer"
    },
    "updated_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "resource_id",
    "source_object_hash",
    "probe",
    "state",
    "created_at",
    "updated_at"
  ],
  "title": "DataPreparationRun",
  "type": "object"
}
