{
  "$defs": {
    "FieldRoleBinding": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldSnapshot"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "field"
      ],
      "title": "FieldRoleBinding",
      "type": "object"
    },
    "FieldSnapshot": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "logical_type": {
          "enum": [
            "numeric",
            "categorical",
            "datetime",
            "boolean",
            "text"
          ],
          "title": "Logical Type",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_dataset_ref": {
          "$ref": "#/$defs/SourceDatasetRef"
        },
        "unit": {
          "$ref": "#/$defs/UnitSpec"
        }
      },
      "required": [
        "field_id",
        "name",
        "logical_type",
        "unit",
        "source_dataset_ref"
      ],
      "title": "FieldSnapshot",
      "type": "object"
    },
    "SourceDatasetRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_dataset_id",
        "source_version",
        "content_hash"
      ],
      "title": "SourceDatasetRef",
      "type": "object"
    },
    "UnitSpec": {
      "additionalProperties": false,
      "properties": {
        "canonical_unit": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Unit"
        },
        "dimensionality": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Dimensionality",
          "type": "string"
        },
        "kind": {
          "enum": [
            "recognized",
            "opaque",
            "dimensionless"
          ],
          "title": "Kind",
          "type": "string"
        },
        "registry_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Registry Version",
          "type": "string"
        },
        "source_text": {
          "maxLength": 128,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "source_text",
        "dimensionality",
        "kind",
        "registry_version"
      ],
      "title": "UnitSpec",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/field-mapping.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/FieldRoleBinding"
      },
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "chart_type_id": {
      "enum": [
        "K01",
        "K02",
        "K03",
        "K04",
        "K05",
        "K06",
        "K07",
        "K08",
        "K09",
        "K10",
        "K11",
        "K12",
        "K13",
        "K14",
        "K15",
        "K16",
        "K17",
        "K18",
        "K19",
        "K20",
        "K21",
        "K22",
        "K24",
        "K25",
        "S01",
        "S05",
        "S21",
        "S25",
        "S31",
        "S34",
        "S61",
        "X01",
        "X02",
        "X03",
        "X05",
        "X07",
        "X09",
        "X11",
        "X12",
        "X13",
        "X15",
        "X16",
        "X17",
        "X18",
        "X19",
        "X23",
        "X24",
        "X35",
        "X36",
        "X37",
        "X38",
        "X39",
        "X40",
        "S07"
      ],
      "title": "Chart Type Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "field_mapping_id": {
      "pattern": "^mapping:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Field Mapping Id",
      "type": "string"
    },
    "mapping_version": {
      "minimum": 1,
      "title": "Mapping Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_dataset_refs": {
      "items": {
        "$ref": "#/$defs/SourceDatasetRef"
      },
      "minItems": 1,
      "title": "Source Dataset Refs",
      "type": "array"
    }
  },
  "required": [
    "field_mapping_id",
    "mapping_version",
    "chart_type_id",
    "source_dataset_refs",
    "bindings",
    "content_hash"
  ],
  "title": "FieldMapping",
  "type": "object"
}
