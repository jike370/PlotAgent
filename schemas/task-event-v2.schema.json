        "event_id": {
          "pattern": "^event:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "user_task_event",
          "default": "user_task_event",
          "title": "Event Type",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
