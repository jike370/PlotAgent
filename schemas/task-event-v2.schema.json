    "UserTaskEvent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "answered",
            "confirmed",
            "rejected",
            "corrected",
            "cancel_requested",
            "budget_extended",
            "partial_accepted",
            "resumed"
          ],
