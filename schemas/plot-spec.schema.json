{
  "$defs": {
    "AnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
        },
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X2"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "AnnotationSpec",
      "type": "object"
    },
    "AxisRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        }
      },
      "title": "AxisRange",
      "type": "object"
    },
    "AxisSpec": {
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "pattern": "^axis:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Axis Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/SafeRichText"
        },
        "orientation": {
          "enum": [
            "x",
            "y",
            "color"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "position": {
          "enum": [
            "bottom",
            "top",
            "left",
            "right",
            "none"
          ],
          "title": "Position",
          "type": "string"
        },
        "scale_id": {
          "pattern": "^scale:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scale Id",
          "type": "string"
        }
      },
      "required": [
        "axis_id",
        "scale_id",
        "orientation",
        "position",
        "label"
      ],
      "title": "AxisSpec",
      "type": "object"
    },
    "AxisTickSpec": {
      "additionalProperties": false,
      "properties": {
        "decimal_places": {
          "default": 3,
          "maximum": 12,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "major_interval": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Major Interval"
        },
        "number_format": {
          "default": "auto",
          "enum": [
            "auto",
            "fixed",
            "scientific"
          ],
          "title": "Number Format",
          "type": "string"
        }
      },
      "title": "AxisTickSpec",
      "type": "object"
    },
    "BarAreaEditSpec": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Alpha",
          "type": "number"
        },
        "edge_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_width": {
          "$ref": "#/$defs/PhysicalLength",
          "default": {
            "unit": "pt",
            "value": 0.5
          }
        },
        "fill_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width_ratio": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width Ratio",
          "type": "number"
        }
      },
      "title": "BarAreaEditSpec",
      "type": "object"
    },
    "CalculatedSeriesData": {
      "additionalProperties": false,
      "properties": {
        "calculation_result_ref": {
          "$ref": "#/$defs/PlotCalculationResultRef"
        },
        "kind": {
          "const": "calculated",
          "default": "calculated",
          "title": "Kind",
          "type": "string"
        },
        "role_fields": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Fields",
          "type": "array"
        }
      },
      "required": [
        "calculation_result_ref",
        "role_fields"
      ],
      "title": "CalculatedSeriesData",
      "type": "object"
    },
    "CategoricalFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "const": "bar",
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "categorical",
          "default": "categorical",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "CategoricalFamily",
      "type": "object"
    },
    "ChartParameterEditSpec": {
      "additionalProperties": false,
      "properties": {
        "lollipop_baseline": {
          "default": 0.0,
          "title": "Lollipop Baseline",
          "type": "number"
        },
        "pareto_reference_percent": {
          "default": 80.0,
          "exclusiveMaximum": 100,
          "exclusiveMinimum": 0,
          "title": "Pareto Reference Percent",
          "type": "number"
        },
        "step_where": {
          "default": "post",
          "enum": [
            "pre",
            "mid",
            "post"
          ],
          "title": "Step Where",
          "type": "string"
        },
        "volcano_absolute_log2_fold_change": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Volcano Absolute Log2 Fold Change",
          "type": "number"
        },
        "volcano_pvalue": {
          "default": 0.05,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Volcano Pvalue",
          "type": "number"
        }
      },
      "title": "ChartParameterEditSpec",
      "type": "object"
    },
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
    "ColorbarEditSpec": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "default": 7,
          "maximum": 64,
          "minimum": 2,
          "title": "Levels",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "title": "ColorbarEditSpec",
      "type": "object"
    },
    "DistributionFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "enum": [
              "strip",
              "box",
              "violin",
              "histogram",
              "density",
              "step"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "distribution",
          "default": "distribution",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "DistributionFamily",
      "type": "object"
    },
    "DoseResponseFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "enum": [
              "symbol",
              "line",
              "band"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "dose_response",
          "default": "dose_response",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "DoseResponseFamily",
      "type": "object"
    },
    "DualYAxisEditSpec": {
      "additionalProperties": false,
      "properties": {
        "axis_width": {
          "$ref": "#/$defs/PhysicalLength",
          "default": {
            "unit": "pt",
            "value": 0.8
          }
        },
        "left_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "right_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DualYAxisEditSpec",
      "type": "object"
    },
    "FacetEditSpec": {
      "additionalProperties": false,
      "properties": {
        "common_legend": {
          "default": true,
          "title": "Common Legend",
          "type": "boolean"
        },
        "gap": {
          "$ref": "#/$defs/PhysicalLength",
          "default": {
            "unit": "mm",
            "value": 4.0
          }
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FacetLabelEdit"
          },
          "title": "Labels",
          "type": "array"
        },
        "order": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        },
        "shared_x": {
          "default": true,
          "title": "Shared X",
          "type": "boolean"
        },
        "shared_y": {
          "default": true,
          "title": "Shared Y",
          "type": "boolean"
        }
      },
      "title": "FacetEditSpec",
      "type": "object"
    },
    "FacetFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "const": "panel",
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "facet",
          "default": "facet",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "FacetFamily",
      "type": "object"
    },
    "FacetLabelEdit": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "FacetLabelEdit",
      "type": "object"
    },
    "ForestFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "enum": [
              "interval",
              "symbol"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "forest",
          "default": "forest",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "ForestFamily",
      "type": "object"
    },
    "LegendSpec": {
      "additionalProperties": false,
      "properties": {
        "anchor_x": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Y",
          "type": "number"
        },
        "placement": {
          "default": "inside",
          "enum": [
            "inside",
            "outside_right",
            "outside_bottom"
          ],
          "title": "Placement",
          "type": "string"
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible"
        }
      },
      "title": "LegendSpec",
      "type": "object"
    },
    "MatrixFamily": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "enum": [
              "heatmap",
              "contour"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Geometry",
          "type": "array"
        },
        "kind": {
          "const": "matrix",
          "default": "matrix",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "geometry"
      ],
      "title": "MatrixFamily",
      "type": "object"
    },
    "PhysicalLength": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "pt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "PhysicalLength",
      "type": "object"
    },
    "PhysicalSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "width": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "PhysicalSize",
      "type": "object"
    },
    "PlotCalculationResultRef": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "pattern": "^plotcalc:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Calculation Id",
          "type": "string"
        },
        "calculation_kind": {
          "enum": [
            "histogram_binning",
            "tukey_box",
            "violin_kde",
            "density_kde",
            "ecdf",
            "summary_error",
            "percent_stack",
            "matrix_projection",
            "confusion_count"
          ],
          "title": "Calculation Kind",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "result_version": {
          "minimum": 1,
          "title": "Result Version",
          "type": "integer"
        }
      },
      "required": [
        "calculation_id",
        "result_version",
        "calculation_kind",
        "content_hash"
      ],
      "title": "PlotCalculationResultRef",
      "type": "object"
    },
    "PlotProvenance": {
      "additionalProperties": false,
      "properties": {
        "engine_build_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Build Hash",
          "type": "string"
        },
        "origin": {
          "enum": [
            "manual",
            "agent_plan"
          ],
          "title": "Origin",
          "type": "string"
        },
        "parent_plot_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlotSpecRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_id": {
          "anyOf": [
            {
              "pattern": "^plan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "user_instruction_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Instruction Hash"
        }
      },
      "required": [
        "origin",
        "engine_build_hash"
      ],
      "title": "PlotProvenance",
      "type": "object"
    },
    "PlotSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "plot_id": {
          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "plot_version": {
          "minimum": 1,
          "title": "Plot Version",
          "type": "integer"
        }
      },
      "required": [
        "plot_id",
        "plot_version",
        "content_hash"
      ],
      "title": "PlotSpecRef",
      "type": "object"
    },
    "PrecomputedDataRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_ref_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Data Ref Hash",
          "type": "string"
        },
        "field_ids": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "precomputed_id": {
          "pattern": "^precomputed:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Precomputed Id",
          "type": "string"
        },
        "precomputed_kind": {
          "enum": [
            "curve",
            "band",
            "matrix",
            "matrix_grid",
            "step_curve",
            "risk_table",
            "parameter_table",
            "spectrum",
            "peak_labels",
            "complex_curve",
            "effect_interval"
          ],
          "title": "Precomputed Kind",
          "type": "string"
        },
        "precomputed_version": {
          "minimum": 1,
          "title": "Precomputed Version",
          "type": "integer"
        },
        "provenance": {
          "const": "user_provided_precomputed",
          "default": "user_provided_precomputed",
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "precomputed_id",
        "precomputed_version",
        "precomputed_kind",
        "content_hash",
        "data_ref_hash",
        "field_ids"
      ],
      "title": "PrecomputedDataRef",
      "type": "object"
    },
    "PrecomputedSeriesData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "precomputed",
          "default": "precomputed",
          "title": "Kind",
          "type": "string"
        },
        "precomputed_data_ref": {
          "$ref": "#/$defs/PrecomputedDataRef"
        },
        "role_fields": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Fields",
          "type": "array"
        }
      },
      "required": [
        "precomputed_data_ref",
        "role_fields"
      ],
      "title": "PrecomputedSeriesData",
      "type": "object"
    },
    "PreparedDatasetRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "prepared_dataset_id": {
          "pattern": "^prepared:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Prepared Dataset Id",
          "type": "string"
        },
        "prepared_version": {
          "minimum": 1,
          "title": "Prepared Version",
          "type": "integer"
        }
      },
      "required": [
        "prepared_dataset_id",
        "prepared_version",
        "content_hash"
      ],
      "title": "PreparedDatasetRef",
      "type": "object"
    },
    "PreparedSeriesData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "prepared",
          "default": "prepared",
          "title": "Kind",
          "type": "string"
        },
        "prepared_dataset_ref": {
          "$ref": "#/$defs/PreparedDatasetRef"
        },
        "role_fields": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Fields",
          "type": "array"
        }
      },
      "required": [
        "prepared_dataset_ref",
        "role_fields"
      ],
      "title": "PreparedSeriesData",
