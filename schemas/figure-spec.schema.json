{
  "$defs": {
    "FigurePanel": {
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "panel_label": {
          "$ref": "#/$defs/SafeRichText"
        },
        "plot_version_ref": {
          "$ref": "#/$defs/PlotSpecRef"
        }
      },
      "required": [
        "panel_id",
        "plot_version_ref",
        "panel_label"
      ],
      "title": "FigurePanel",
      "type": "object"
    },
    "PhysicalLength": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "pt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "PhysicalLength",
      "type": "object"
    },
    "PhysicalSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "width": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "PhysicalSize",
      "type": "object"
    },
    "PlotSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "plot_id": {
          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "plot_version": {
          "minimum": 1,
          "title": "Plot Version",
          "type": "integer"
        }
      },
      "required": [
        "plot_id",
        "plot_version",
        "content_hash"
      ],
      "title": "PlotSpecRef",
      "type": "object"
    },
    "PublicationProfileSnapshot": {
      "additionalProperties": false,
      "properties": {
        "color_space": {
          "const": "sRGB",
          "default": "sRGB",
          "title": "Color Space",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dpi": {
          "maximum": 2400,
          "minimum": 72,
          "title": "Dpi",
          "type": "integer"
        },
        "physical_size": {
          "$ref": "#/$defs/PhysicalSize"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minimum": 1,
          "title": "Profile Version",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "content_hash",
        "physical_size",
        "dpi"
      ],
      "title": "PublicationProfileSnapshot",
      "type": "object"
    },
    "SafeRichText": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/SafeTextNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "SafeRichText",
      "type": "object"
    },
    "SafeTextNode": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "kind": {
          "enum": [
            "plain",
            "newline",
            "sub",
            "sup",
            "bold",
            "italic",
            "fraction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SafeTextNode",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/figure-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alignment": {
      "default": "align_both",
      "enum": [
        "independent",
        "align_x",
        "align_y",
        "align_both"
      ],
      "title": "Alignment",
      "type": "string"
    },
    "axis_policy": {
      "default": "independent",
      "enum": [
        "independent",
        "shared_x",
        "shared_y",
        "shared_both"
      ],
      "title": "Axis Policy",
      "type": "string"
    },
    "common_legend": {
      "title": "Common Legend",
      "type": "boolean"
    },
    "figure_id": {
      "pattern": "^figure:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Figure Id",
      "type": "string"
    },
    "figure_version": {
      "minimum": 1,
      "title": "Figure Version",
      "type": "integer"
    },
    "layout": {
      "enum": [
        "1x2",
        "1x3",
        "1x4",
        "2x1",
        "2x2",
        "2x3",
        "3x1"
      ],
      "title": "Layout",
      "type": "string"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/FigurePanel"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Panels",
      "type": "array"
    },
    "parent_figure_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Figure Version"
    },
    "physical_size": {
      "$ref": "#/$defs/PhysicalSize"
    },
    "publication_profile": {
      "$ref": "#/$defs/PublicationProfileSnapshot"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "figure_id",
    "figure_version",
    "layout",
    "panels",
    "common_legend",
    "physical_size",
    "publication_profile"
  ],
  "title": "FigureSpec",
  "type": "object"
}
