          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
