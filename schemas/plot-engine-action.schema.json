        "data": {
          "$ref": "#/$defs/EngineDataRef"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "bind_fields",
          "default": "bind_fields",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "data",
        "bindings"
      ],
      "title": "BindFields",
      "type": "object"
    },
    "CreatePlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/FieldBinding"
