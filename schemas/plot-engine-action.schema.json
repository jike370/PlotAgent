      },
      "required": [
        "action_id",
        "plot_id",
        "profile_id",
        "data",
        "bindings"
      ],
      "title": "CreatePlot",
      "type": "object"
    },
    "EngineDataRef": {
      "additionalProperties": false,
      "description": "Immutable data revision consumed by a plot document.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "prepared",
            "calculated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "version",
        "content_hash"
      ],
      "title": "EngineDataRef",
      "type": "object"
    },
    "ExportPlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
