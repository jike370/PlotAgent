{
  "$defs": {
    "AddAnnotation": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "annotation_id": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "coordinate_system": {
          "default": "data",
          "enum": [
            "data",
            "axes",
            "page"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "font_family": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "Arial",
                "Calibri",
                "Times New Roman",
                "Segoe UI",
                "Microsoft YaHei",
                "SimSun"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Family"
        },
        "font_size_pt": {
          "anyOf": [
            {
              "maximum": 72,
              "minimum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Pt"
        },
        "font_weight": {
          "anyOf": [
            {
              "enum": [
                "normal",
                "bold"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Weight"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Italic"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "rotation_deg": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Deg"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "annotation_id",
        "text",
        "x",
        "y"
      ],
      "title": "AddAnnotation",
      "type": "object"
    },
    "BindFields": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
