          "const": "export_plot",
          "default": "export_plot",
          "title": "Operation",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[^\\\\/:*?\\\"<>|\\r\\n]{1,120}$",
          "title": "Output Name",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "format",
        "output_name"
