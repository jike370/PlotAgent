    "AddAnnotationPatch": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationSpec"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(plot|series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "annotation"
      ],
      "title": "AddAnnotationPatch",
      "type": "object"
    },
    "AnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
