          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X2"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "AnnotationSpec",
      "type": "object"
    },
