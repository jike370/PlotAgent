{
  "$defs": {
    "ProbedTable": {
      "additionalProperties": false,
      "description": "Non-semantic structure facts observed for one candidate table.",
      "properties": {
        "column_count": {
          "minimum": 1,
          "title": "Column Count",
          "type": "integer"
        },
        "column_names": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Column Names",
          "type": "array"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "logical_types": {
          "items": {
            "enum": [
              "numeric",
              "categorical",
              "datetime",
              "boolean",
              "text"
            ],
            "type": "string"
          },
          "title": "Logical Types",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "structure_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Structure Hash",
          "type": "string"
        },
        "table_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Table Key",
          "type": "string"
        },
        "unit_labels": {
          "items": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Unit Labels",
          "type": "array"
        }
      },
      "required": [
        "table_key",
        "display_name",
        "row_count",
        "column_count",
        "column_names",
        "logical_types",
        "unit_labels",
        "structure_hash"
      ],
      "title": "ProbedTable",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v2/source-structure-probe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "generic_parser_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generic Parser Code"
    },
    "generic_parser_outcome": {
      "enum": [
        "imported",
        "clarification",
        "rejection"
      ],
      "title": "Generic Parser Outcome",
      "type": "string"
    },
    "marker_hashes": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Marker Hashes",
      "type": "array"
    },
    "probe_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Probe Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "source-structure-probe.v1",
      "default": "source-structure-probe.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_format": {
      "enum": [
        "csv",
        "tsv",
        "txt",
        "dat",
        "xlsx",
        "xlsm",
        "xls"
      ],
      "title": "Source Format",
      "type": "string"
    },
    "source_object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Object Hash",
      "type": "string"
    },
    "tables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProbedTable"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "source_object_hash",
    "source_format",
    "byte_size",
    "generic_parser_outcome",
    "probe_hash"
  ],
  "title": "SourceStructureProbe",
  "type": "object"
}
