{
  "$defs": {
    "ExportValidationRequirements": {
      "additionalProperties": false,
      "properties": {
        "require_fresh_reopen": {
          "default": false,
          "title": "Require Fresh Reopen",
          "type": "boolean"
        },
        "validate_content": {
          "const": true,
          "default": true,
          "title": "Validate Content",
          "type": "boolean"
        },
        "validate_dimensions": {
          "const": true,
          "default": true,
          "title": "Validate Dimensions",
          "type": "boolean"
        },
        "validate_structure": {
          "const": true,
          "default": true,
          "title": "Validate Structure",
          "type": "boolean"
        }
      },
      "title": "ExportValidationRequirements",
      "type": "object"
    },
    "ObjectVersionRef": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "object_id": {
          "pattern": "^(source|mapping|preparation|prepared|plotcalc|plot|batch|figure|export|renderplan|originplan|plan|project):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "expected_version"
      ],
      "title": "ObjectVersionRef",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "description": "An Electron-authorized resource reference, never a filesystem path.",
      "properties": {
        "resource_id": {
          "pattern": "^resource:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "authorized_file",
            "authorized_directory",
            "temporary_output"
          ],
          "title": "Resource Kind",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "resource_kind"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/export-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "export_id": {
      "pattern": "^export:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Export Id",
      "type": "string"
    },
    "export_version": {
      "minimum": 1,
      "title": "Export Version",
      "type": "integer"
    },
    "format": {
      "enum": [
        "png",
        "svg",
        "opju"
      ],
      "title": "Format",
      "type": "string"
    },
    "output_name": {
      "pattern": "^[^\\\\/:*?\\\"<>|\\r\\n]{1,120}$",
      "title": "Output Name",
      "type": "string"
    },
    "render_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Plan Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_refs": {
      "items": {
        "$ref": "#/$defs/ObjectVersionRef"
      },
      "minItems": 1,
      "title": "Target Refs",
      "type": "array"
    },
    "target_resource": {
      "$ref": "#/$defs/ResourceRef"
    },
    "target_scope": {
      "enum": [
        "current_plot",
        "selected_plots",
        "batch",
        "figure"
      ],
      "title": "Target Scope",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ExportValidationRequirements",
      "default": {
        "require_fresh_reopen": false,
        "validate_content": true,
        "validate_dimensions": true,
        "validate_structure": true
      }
    }
  },
  "required": [
    "export_id",
    "export_version",
    "format",
    "target_scope",
    "target_refs",
    "target_resource",
    "output_name",
    "render_plan_hash"
  ],
  "title": "ExportSpec",
  "type": "object"
}
