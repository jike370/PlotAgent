{
  "$defs": {
    "ContextFieldBinding": {
      "additionalProperties": false,
      "properties": {
        "field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field Alias",
          "type": "string"
        },
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "field_alias",
        "field_id",
        "source_dataset_id",
        "source_version"
      ],
      "title": "ContextFieldBinding",
      "type": "object"
    },
    "ContextObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "object_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Object Alias",
          "type": "string"
        },
        "object_id": {
          "pattern": "^(source|mapping|preparation|prepared|plotcalc|plot|batch|figure|export|renderplan|originplan|plan|project):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "source_dataset",
            "prepared_dataset",
            "plot",
            "batch",
            "figure",
            "export",
            "project"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "minimum": 1,
          "title": "Object Version",
          "type": "integer"
        }
      },
      "required": [
        "object_alias",
        "object_id",
        "object_version",
        "object_type"
      ],
      "title": "ContextObjectRef",
      "type": "object"
    },
    "ConversationStateProjection": {
      "additionalProperties": false,
      "properties": {
        "confirmed_field_aliases": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Confirmed Field Aliases",
          "type": "array"
        },
        "current_target": {
          "$ref": "#/$defs/ContextObjectRef"
        },
        "project_rule_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Project Rule Ids",
          "type": "array"
        },
        "recent_result_kinds": {
          "default": [],
          "items": {
            "enum": [
              "action_plan",
              "needs_input",
              "unsupported",
              "no_change",
              "execution_result"
            ],
            "type": "string"
          },
          "title": "Recent Result Kinds",
          "type": "array"
        },
        "saved_setting_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Saved Setting Refs",
          "type": "array"
        },
        "selected_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextObjectRef"
          },
          "title": "Selected Objects",
          "type": "array"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "unresolved_question_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Unresolved Question Ids",
          "type": "array"
        }
      },
      "required": [
        "state_version",
        "current_target"
      ],
      "title": "ConversationStateProjection",
      "type": "object"
    },
    "ProjectContextSnapshot": {
      "additionalProperties": false,
      "description": "Local authority used to compile a provider proposal into executable work.\n\nThe provider receives a minimized ``ContextEnvelope`` projection.  This richer\nsnapshot remains local and binds aliases to stable object ids and versions.",
      "properties": {
        "conversation_id": {
          "pattern": "^conversation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Conversation Id",
          "type": "string"
        },
        "conversation_state": {
          "$ref": "#/$defs/ConversationStateProjection"
        },
        "field_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextFieldBinding"
          },
          "maxItems": 256,
          "title": "Field Bindings",
          "type": "array"
        },
        "known_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextObjectRef"
          },
          "maxItems": 128,
          "title": "Known Objects",
          "type": "array"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_revision": {
          "minimum": 0,
          "title": "Project Revision",
          "type": "integer"
        },
        "project_rule_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Project Rule Ids",
          "type": "array"
        },
        "recent_result_objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextObjectRef"
          },
          "maxItems": 16,
          "title": "Recent Result Objects",
          "type": "array"
        },
        "saved_setting_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Saved Setting Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^context:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "snapshot_hash",
        "project_id",
        "project_revision",
        "conversation_id",
        "conversation_state"
      ],
      "title": "ProjectContextSnapshot",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/project-context-snapshot.schema.json",
  "$ref": "#/$defs/ProjectContextSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectContextSnapshotContract"
}
