      "type": "array"
    },
    "patches": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_annotation": "#/$defs/AddAnnotationPatch",
            "apply_publication_profile": "#/$defs/ApplyPublicationProfilePatch",
            "move_legend": "#/$defs/MoveLegendPatch",
            "remove_annotation": "#/$defs/RemoveAnnotationPatch",
            "set_axis_label": "#/$defs/SetAxisLabelPatch",
            "set_axis_range": "#/$defs/SetAxisRangePatch",
            "set_axis_reverse": "#/$defs/SetAxisReversePatch",
            "set_axis_scale": "#/$defs/SetAxisScalePatch",
            "set_axis_ticks": "#/$defs/SetAxisTicksPatch",
            "set_batch_axis_policy": "#/$defs/SetBatchAxisPolicyPatch",
            "set_canvas_size": "#/$defs/SetCanvasSizePatch",
            "set_category_color": "#/$defs/SetCategoryColorPatch",
            "set_font_size": "#/$defs/SetFontSizePatch",
            "set_legend_visibility": "#/$defs/SetLegendVisibilityPatch",
            "set_palette": "#/$defs/SetPalettePatch",
            "set_plot_title": "#/$defs/SetPlotTitlePatch",
            "set_series_style": "#/$defs/SetSeriesStylePatch",
            "update_annotation": "#/$defs/UpdateAnnotationPatch"
          },
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SetPlotTitlePatch"
          },
          {
            "$ref": "#/$defs/SetAxisRangePatch"
          },
          {
            "$ref": "#/$defs/SetAxisScalePatch"
          },
          {
            "$ref": "#/$defs/SetAxisLabelPatch"
          },
          {
            "$ref": "#/$defs/SetAxisReversePatch"
          },
          {
            "$ref": "#/$defs/SetAxisTicksPatch"
          },
          {
            "$ref": "#/$defs/SetFontSizePatch"
          },
          {
            "$ref": "#/$defs/SetSeriesStylePatch"
          },
          {
            "$ref": "#/$defs/SetPalettePatch"
          },
          {
            "$ref": "#/$defs/SetCategoryColorPatch"
          },
          {
            "$ref": "#/$defs/MoveLegendPatch"
          },
          {
            "$ref": "#/$defs/SetLegendVisibilityPatch"
          },
          {
            "$ref": "#/$defs/AddAnnotationPatch"
          },
          {
            "$ref": "#/$defs/UpdateAnnotationPatch"
          },
          {
