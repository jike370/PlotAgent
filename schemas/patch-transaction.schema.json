    "AxisTickSpec": {
      "additionalProperties": false,
      "properties": {
        "decimal_places": {
          "default": 3,
          "maximum": 12,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "major_interval": {
