{
  "$defs": {
    "AddAnnotationPatch": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationSpec"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^(plot|series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "expected_plot_version",
        "annotation"
      ],
      "title": "AddAnnotationPatch",
      "type": "object"
    },
    "AnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
        },
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X2"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "AnnotationSpec",
      "type": "object"
    },
