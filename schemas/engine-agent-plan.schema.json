{
  "$defs": {
    "AgentAddAnnotation": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "annotation_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Annotation Alias",
          "type": "string"
        },
        "coordinate_system": {
          "default": "data",
          "enum": [
            "data",
            "axes",
            "page"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "annotation_alias",
        "text",
        "x",
        "y"
      ],
      "title": "AgentAddAnnotation",
      "type": "object"
    },
    "AgentBindFields": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/AgentFieldBinding"
          },
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "operation": {
          "const": "bind_fields",
          "default": "bind_fields",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "source_alias",
        "bindings"
      ],
      "title": "AgentBindFields",
      "type": "object"
    },
    "AgentCreatePlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/AgentFieldBinding"
          },
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "operation": {
          "const": "create_plot",
          "default": "create_plot",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "source_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Alias",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "profile_id",
        "source_alias",
        "bindings"
      ],
      "title": "AgentCreatePlot",
      "type": "object"
    },
    "AgentExportPlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "format": {
          "enum": [
            "png",
            "svg",
            "opju"
          ],
          "title": "Format",
          "type": "string"
        },
        "operation": {
          "const": "export_plot",
          "default": "export_plot",
          "title": "Operation",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "format",
        "output_name"
      ],
      "title": "AgentExportPlot",
      "type": "object"
    },
    "AgentFieldBinding": {
      "additionalProperties": false,
      "properties": {
        "field_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field Alias",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "field_alias"
      ],
      "title": "AgentFieldBinding",
      "type": "object"
    },
    "AgentSetAxis": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "axis_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Axis Alias",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "operation": {
          "const": "set_axis",
          "default": "set_axis",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "reverse": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reverse"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "log10",
                "datetime",
                "categorical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "axis_alias"
      ],
      "title": "AgentSetAxis",
      "type": "object"
    },
    "AgentSetChartParameter": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "operation": {
          "const": "set_chart_parameter",
          "default": "set_chart_parameter",
          "title": "Operation",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Parameter",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "parameter",
        "value"
      ],
      "title": "AgentSetChartParameter",
      "type": "object"
    },
    "AgentSetLegend": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "enum": [
                "inside",
                "right",
                "bottom",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "operation": {
          "const": "set_legend",
          "default": "set_legend",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible"
        }
      },
      "required": [
        "action_id",
        "plot_alias"
      ],
      "title": "AgentSetLegend",
      "type": "object"
    },
    "AgentSetSeriesStyle": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "line_style": {
          "anyOf": [
            {
              "enum": [
                "solid",
                "dash",
                "dot",
                "dash_dot",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Style"
        },
        "line_width_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Width Pt"
        },
        "operation": {
          "const": "set_series_style",
          "default": "set_series_style",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "series_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Series Alias",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "symbol_size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 72,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol Size Pt"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "series_alias"
      ],
      "title": "AgentSetSeriesStyle",
      "type": "object"
    },
    "AgentSetTitle": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "operation": {
          "const": "set_title",
          "default": "set_title",
          "title": "Operation",
          "type": "string"
        },
        "plot_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Plot Alias",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plot_alias",
        "text"
      ],
      "title": "AgentSetTitle",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v2/engine-agent-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_annotation": "#/$defs/AgentAddAnnotation",
            "bind_fields": "#/$defs/AgentBindFields",
            "create_plot": "#/$defs/AgentCreatePlot",
            "export_plot": "#/$defs/AgentExportPlot",
            "set_axis": "#/$defs/AgentSetAxis",
            "set_chart_parameter": "#/$defs/AgentSetChartParameter",
            "set_legend": "#/$defs/AgentSetLegend",
            "set_series_style": "#/$defs/AgentSetSeriesStyle",
            "set_title": "#/$defs/AgentSetTitle"
          },
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AgentCreatePlot"
          },
          {
            "$ref": "#/$defs/AgentBindFields"
          },
          {
            "$ref": "#/$defs/AgentSetTitle"
          },
          {
            "$ref": "#/$defs/AgentSetAxis"
          },
          {
            "$ref": "#/$defs/AgentSetSeriesStyle"
          },
          {
            "$ref": "#/$defs/AgentSetLegend"
          },
          {
            "$ref": "#/$defs/AgentSetChartParameter"
          },
          {
            "$ref": "#/$defs/AgentAddAnnotation"
          },
          {
            "$ref": "#/$defs/AgentExportPlot"
          }
        ]
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "decision_type": {
      "const": "action_plan",
      "default": "action_plan",
      "title": "Decision Type",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^plan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "engine-agent.v1",
      "default": "engine-agent.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_alias": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Target Alias",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "target_alias",
    "actions"
  ],
  "title": "EngineAgentPlan",
  "type": "object"
}
