    "DataRequest": {
      "additionalProperties": false,
      "description": "A bounded request for explicitly authorized additional context.\n\nProvider-visible aliases are resolved to authoritative object/field ids and\nversions locally.  The model never supplies a table id or storage location.",
      "properties": {
        "authorization_scope": {
          "enum": [
            "this_run",
            "this_conversation_similar"
          ],
          "title": "Authorization Scope",
          "type": "string"
        },
        "dataset_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Dataset Alias",
          "type": "string"
        },
        "default_context_insufficient_reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Default Context Insufficient Reason",
          "type": "string"
        },
        "estimated_field_count": {
          "maximum": 12,
          "minimum": 1,
          "title": "Estimated Field Count",
          "type": "integer"
        },
        "estimated_row_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Estimated Row Count",
          "type": "integer"
        },
        "estimated_scalar_count": {
          "maximum": 200,
          "minimum": 0,
          "title": "Estimated Scalar Count",
          "type": "integer"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "field_aliases": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Field Aliases",
          "type": "array"
        },
        "purpose": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "requested_categories": {
          "items": {
            "enum": [
              "field_metadata",
              "statistics",
              "sample"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Categories",
          "type": "array"
        },
        "smaller_scope_possible": {
          "title": "Smaller Scope Possible",
          "type": "boolean"
        }
      },
      "required": [
        "dataset_alias",
        "expected_version",
        "field_aliases",
        "requested_categories",
        "estimated_field_count",
        "estimated_row_count",
        "estimated_scalar_count",
        "purpose",
        "default_context_insufficient_reason",
        "smaller_scope_possible",
        "authorization_scope"
      ],
      "title": "DataRequest",
      "type": "object"
    },
    "ExportArtifactAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "const": "export_artifact",
          "default": "export_artifact",
          "title": "Action Type",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "format": {
          "enum": [
            "png",
            "svg",
            "opju"
          ],
          "title": "Format",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[^\\\\/:*?\\\"<>|\\r\\n]{1,120}$",
          "title": "Output Name",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "current_plot",
            "selected_plots",
            "batch",
            "figure"
          ],
          "title": "Target Scope",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "target_alias",
        "format",
        "target_scope",
        "output_name"
      ],
      "title": "ExportArtifactAction",
      "type": "object"
    },
