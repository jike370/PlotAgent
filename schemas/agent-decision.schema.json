{
  "$defs": {
    "ActionPlan": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "create_batch": "#/$defs/CreateBatchAction",
                "create_figure": "#/$defs/CreateFigureAction",
                "create_plot": "#/$defs/CreatePlotAction",
                "export_artifact": "#/$defs/ExportArtifactAction",
                "patch_batch": "#/$defs/PatchBatchAction",
                "patch_figure": "#/$defs/PatchFigureAction",
                "patch_plot": "#/$defs/PatchPlotAction"
              },
              "propertyName": "action_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CreatePlotAction"
              },
              {
                "$ref": "#/$defs/PatchPlotAction"
              },
              {
                "$ref": "#/$defs/CreateBatchAction"
              },
              {
                "$ref": "#/$defs/PatchBatchAction"
              },
              {
                "$ref": "#/$defs/CreateFigureAction"
              },
              {
                "$ref": "#/$defs/PatchFigureAction"
              },
              {
                "$ref": "#/$defs/ExportArtifactAction"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "confirmation": {
          "default": "not_required",
          "enum": [
            "not_required",
            "required"
          ],
          "title": "Confirmation",
          "type": "string"
        },
        "decision_type": {
          "const": "action_plan",
          "default": "action_plan",
          "title": "Decision Type",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^plan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "target_alias",
        "actions"
      ],
      "title": "ActionPlan",
      "type": "object"
    },
    "AxisLabelIntent": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "operation": {
          "const": "set_axis_label",
          "default": "set_axis_label",
          "title": "Operation",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        }
      },
      "required": [
        "target_alias",
        "label"
      ],
      "title": "AxisLabelIntent",
      "type": "object"
    },
    "AxisRangeIntent": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "operation": {
          "const": "set_axis_range",
          "default": "set_axis_range",
          "title": "Operation",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        }
      },
      "required": [
        "target_alias",
        "minimum",
        "maximum"
      ],
      "title": "AxisRangeIntent",
      "type": "object"
    },
    "AxisScaleIntent": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "set_axis_scale",
          "default": "set_axis_scale",
          "title": "Operation",
          "type": "string"
        },
        "scale": {
          "enum": [
            "linear",
            "log10",
            "datetime",
            "categorical"
          ],
          "title": "Scale",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        }
      },
      "required": [
        "target_alias",
        "scale"
      ],
      "title": "AxisScaleIntent",
      "type": "object"
    },
    "CanvasSizeIntent": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "set_canvas_size",
          "default": "set_canvas_size",
          "title": "Operation",
          "type": "string"
        },
        "physical_size": {
          "$ref": "#/$defs/PhysicalSize"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        }
      },
      "required": [
        "target_alias",
        "physical_size"
      ],
      "title": "CanvasSizeIntent",
      "type": "object"
    },
    "CategoryColorIntent": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        },
        "operation": {
          "const": "set_category_color",
          "default": "set_category_color",
          "title": "Operation",
          "type": "string"
        },
        "target_alias": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target Alias",
          "type": "string"
        }
      },
      "required": [
        "target_alias",
        "category",
        "color"
      ],
      "title": "CategoryColorIntent",
      "type": "object"
    },
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
