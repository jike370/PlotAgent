{
  "$defs": {
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
    "ContentTableRef": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "object_hash",
        "row_count",
        "field_ids"
      ],
      "title": "ContentTableRef",
      "type": "object"
    },
    "ExportSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "export_id": {
          "pattern": "^export:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Export Id",
          "type": "string"
        },
        "export_version": {
          "minimum": 1,
          "title": "Export Version",
          "type": "integer"
        }
      },
      "required": [
        "export_id",
        "export_version",
        "content_hash"
      ],
      "title": "ExportSpecRef",
      "type": "object"
    },
    "OriginAxisPlan": {
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Axis Id",
          "type": "string"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "orientation": {
          "enum": [
            "x",
            "y"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "top",
            "left",
            "right",
            "none"
          ],
          "title": "Position",
          "type": "string"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
        "scale": {
          "enum": [
            "linear",
            "log10",
            "datetime",
            "categorical"
          ],
          "title": "Scale",
          "type": "string"
        },
        "ticks": {
          "items": {
            "$ref": "#/$defs/OriginTickPlan"
          },
          "minItems": 1,
          "title": "Ticks",
          "type": "array"
        },
        "title": {
          "default": "",
          "maxLength": 512,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "axis_id",
        "orientation",
        "scale",
        "minimum",
        "maximum",
        "ticks"
      ],
      "title": "OriginAxisPlan",
      "type": "object"
    },
    "OriginColumnPlan": {
      "additionalProperties": false,
      "description": "One persisted worksheet column with no formula or executable property surface.",
      "properties": {
        "comments": {
          "default": "",
          "maxLength": 512,
          "title": "Comments",
          "type": "string"
        },
        "designation": {
          "enum": [
            "X",
            "Y",
            "Z",
            "XError",
            "YError",
            "Label",
            "Group",
            "None"
          ],
          "title": "Designation",
          "type": "string"
        },
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "logical_type": {
          "enum": [
            "numeric",
            "categorical",
            "datetime",
            "text"
          ],
          "title": "Logical Type",
          "type": "string"
        },
        "long_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Long Name",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "units": {
          "default": "",
          "maxLength": 128,
          "title": "Units",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/OriginScalar"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field_id",
        "role",
        "designation",
        "logical_type",
        "long_name",
        "values"
      ],
      "title": "OriginColumnPlan",
      "type": "object"
    },
    "OriginDataObject": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OriginColumnPlan"
          },
          "title": "Columns",
          "type": "array"
        },
        "data_chain": {
          "enum": [
            "direct",
            "fixed_plot_calculation",
            "user_provided_precomputed"
          ],
          "title": "Data Chain",
          "type": "string"
        },
        "data_ref": {
          "$ref": "#/$defs/ContentTableRef"
        },
        "folder": {
          "enum": [
            "Data",
            "Analysis"
          ],
          "title": "Folder",
          "type": "string"
        },
        "internal_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Internal Name",
          "type": "string"
        },
        "long_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Long Name",
          "type": "string"
        },
        "matrix": {
          "anyOf": [
            {
              "$ref": "#/$defs/OriginMatrixPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "enum": [
            "worksheet",
            "matrixbook"
          ],
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_kind",
        "folder",
        "internal_name",
        "long_name",
        "data_chain",
        "data_ref"
      ],
      "title": "OriginDataObject",
      "type": "object"
    },
    "OriginExactVersion": {
      "additionalProperties": false,
      "properties": {
        "bitness": {
          "const": "x64",
          "default": "x64",
          "title": "Bitness",
          "type": "string"
        },
        "build": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Build",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "build"
      ],
      "title": "OriginExactVersion",
      "type": "object"
    },
    "OriginGraphObject": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResolvedAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "data_object_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Object Ids",
          "type": "array"
        },
        "folder": {
          "const": "Graphs",
          "default": "Graphs",
          "title": "Folder",
          "type": "string"
        },
        "font_family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "font_size_pt": {
          "exclusiveMinimum": 0,
          "title": "Font Size Pt",
          "type": "number"
        },
        "graph_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Graph Id",
          "type": "string"
        },
        "internal_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Internal Name",
          "type": "string"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/OriginLayerPlan"
          },
          "minItems": 1,
          "title": "Layers",
          "type": "array"
        },
        "legend_anchor_x": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Legend Anchor X",
          "type": "number"
        },
        "legend_anchor_y": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Legend Anchor Y",
          "type": "number"
        },
        "legend_visible": {
          "title": "Legend Visible",
          "type": "boolean"
        },
        "long_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Long Name",
          "type": "string"
        },
        "page_height_mm": {
          "exclusiveMinimum": 0,
          "title": "Page Height Mm",
          "type": "number"
        },
        "page_width_mm": {
          "exclusiveMinimum": 0,
          "title": "Page Width Mm",
          "type": "number"
        }
      },
      "required": [
        "graph_id",
        "internal_name",
        "long_name",
        "page_width_mm",
        "page_height_mm",
        "font_family",
        "font_size_pt",
        "legend_visible",
        "layers",
        "data_object_ids"
      ],
      "title": "OriginGraphObject",
      "type": "object"
    },
    "OriginLayerPlan": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/OriginAxisPlan"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Axes",
          "type": "array"
        },
        "height_mm": {
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "layer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Layer Id",
          "type": "string"
        },
        "left_mm": {
          "title": "Left Mm",
          "type": "number"
        },
        "panel_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "plots": {
          "items": {
            "$ref": "#/$defs/OriginPlotPlan"
          },
          "minItems": 1,
          "title": "Plots",
          "type": "array"
        },
        "top_mm": {
          "title": "Top Mm",
          "type": "number"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        }
      },
      "required": [
        "layer_id",
        "panel_id",
        "left_mm",
        "top_mm",
        "width_mm",
        "height_mm",
        "axes",
        "plots"
      ],
      "title": "OriginLayerPlan",
      "type": "object"
    },
    "OriginManifestPlan": {
      "additionalProperties": false,
      "properties": {
        "chart_type_ids": {
          "items": {
            "enum": [
              "K01",
              "K02",
              "K03",
              "K04",
              "K05",
              "K06",
              "K07",
              "K08",
              "K09",
              "K10",
              "K11",
              "K12",
              "K13",
              "K14",
              "K15",
              "K16",
              "K17",
              "K18",
              "K19",
              "K20",
              "K21",
              "K22",
              "K24",
              "K25",
              "S01",
              "S05",
              "S21",
              "S25",
              "S31",
              "S34",
              "S61",
              "X01",
              "X02",
              "X03",
              "X05",
              "X07",
              "X09",
              "X11",
              "X12",
              "X13",
              "X15",
              "X16",
              "X17",
              "X18",
              "X19",
              "X23",
              "X24",
              "X35",
              "X36",
              "X37",
              "X38",
              "S07"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Chart Type Ids",
          "type": "array"
        },
        "data_chains": {
          "items": {
            "enum": [
              "direct",
              "fixed_plot_calculation",
              "user_provided_precomputed"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Chains",
          "type": "array"
        },
        "external_links": {
          "const": false,
          "default": false,
          "title": "External Links",
          "type": "boolean"
        },
        "known_differences": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Known Differences",
          "type": "array"
        },
        "object_map": {
          "items": {
            "$ref": "#/$defs/OriginObjectMapEntry"
          },
          "minItems": 1,
          "title": "Object Map",
          "type": "array"
        },
        "raw_data_triggers_plotagent_recalculation": {
          "const": false,
          "default": false,
          "title": "Raw Data Triggers Plotagent Recalculation",
          "type": "boolean"
        },
        "render_plan_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Render Plan Hashes",
          "type": "array"
        },
        "resolver_versions": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Resolver Versions",
          "type": "array"
        },
        "target_scope": {
          "enum": [
            "current_plot",
            "selected_plots",
            "batch",
            "figure"
          ],
          "title": "Target Scope",
          "type": "string"
        }
      },
      "required": [
        "chart_type_ids",
        "target_scope",
        "object_map",
        "render_plan_hashes",
        "data_chains",
        "resolver_versions"
      ],
      "title": "OriginManifestPlan",
      "type": "object"
    },
    "OriginMatrixPlan": {
      "additionalProperties": false,
      "description": "Native matrix values and coordinate mapping; raster payloads are impossible by type.",
      "properties": {
        "column_count": {
          "minimum": 0,
          "title": "Column Count",
          "type": "integer"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "units": {
          "default": "",
          "maxLength": 128,
          "title": "Units",
          "type": "string"
        },
        "values": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Values",
          "type": "array"
        },
        "x_coordinates": {
          "items": {
            "type": "number"
          },
          "title": "X Coordinates",
          "type": "array"
        },
        "x_labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "X Labels",
          "type": "array"
        },
        "y_coordinates": {
          "items": {
            "type": "number"
          },
          "title": "Y Coordinates",
          "type": "array"
        },
        "y_labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Y Labels",
          "type": "array"
        }
      },
      "required": [
        "row_count",
        "column_count",
        "x_coordinates",
        "y_coordinates",
        "values"
      ],
      "title": "OriginMatrixPlan",
      "type": "object"
    },
    "OriginObjectMapEntry": {
      "additionalProperties": false,
      "properties": {
        "origin_object_ref": {
          "pattern": "^(Data|Analysis|Graphs|Metadata)/[A-Za-z0-9_/]+$",
          "title": "Origin Object Ref",
          "type": "string"
        },
        "plotagent_object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Plotagent Object Id",
          "type": "string"
        }
      },
      "required": [
        "plotagent_object_id",
        "origin_object_ref"
      ],
      "title": "OriginObjectMapEntry",
      "type": "object"
    },
    "OriginPlotPlan": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Data Object Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 512,
          "title": "Label",
          "type": "string"
        },
        "levels": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Levels",
          "type": "array"
        },
        "line_width_pt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Width Pt"
        },
        "marker_size_pt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker Size Pt"
        },
        "native_kind": {
          "enum": [
            "line",
            "line_symbol",
            "scatter",
            "bubble",
            "error_bar",
            "band",
            "area",
            "bar",
            "grouped_bar",
            "stacked_bar",
            "floating_bar",
            "lollipop",
            "percent_bar",
            "horizontal_bar",
            "strip",
            "box",
            "violin",
            "histogram",
            "density",
            "step",
            "heatmap",
            "contour",
            "survival_step",
            "survival_band",
            "risk_table",
            "forest_interval",
            "forest_symbol",
            "spectrum",
            "nyquist",
            "facet_line"
          ],
          "title": "Native Kind",
          "type": "string"
        },
        "palette": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ColorValue"
          },
          "title": "Palette",
          "type": "array"
        },
        "plot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "role_columns": {
          "items": {
            "$ref": "#/$defs/OriginRoleColumn"
          },
          "minItems": 1,
          "title": "Role Columns",
          "type": "array"
        },
        "source_layer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Source Layer Id",
          "type": "string"
        },
        "z_order": {
          "title": "Z Order",
          "type": "integer"
        }
      },
      "required": [
        "plot_id",
        "source_layer_id",
        "native_kind",
        "data_object_id",
        "role_columns",
        "z_order"
      ],
      "title": "OriginPlotPlan",
      "type": "object"
    },
    "OriginRoleColumn": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "field_id"
      ],
      "title": "OriginRoleColumn",
      "type": "object"
    },
    "OriginScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "OriginTemplateRef": {
      "additionalProperties": false,
      "properties": {
        "signature_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature Hash",
          "type": "string"
        },
        "template_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Hash",
          "type": "string"
        },
        "template_resource": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "template_resource",
        "template_hash",
        "signature_hash"
      ],
      "title": "OriginTemplateRef",
      "type": "object"
    },
    "OriginTickPlan": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "OriginTickPlan",
      "type": "object"
    },
    "OriginValidationPlan": {
      "additionalProperties": false,
      "properties": {
        "fresh_reopen_validation": {
          "const": true,
          "default": true,
          "title": "Fresh Reopen Validation",
          "type": "boolean"
        },
        "live_structural_validation": {
          "const": true,
          "default": true,
          "title": "Live Structural Validation",
          "type": "boolean"
        },
        "require_atomic_publish": {
          "const": true,
          "default": true,
          "title": "Require Atomic Publish",
          "type": "boolean"
        },
        "require_no_external_links": {
          "const": true,
          "default": true,
          "title": "Require No External Links",
          "type": "boolean"
        }
      },
      "title": "OriginValidationPlan",
      "type": "object"
    },
    "ResolvedAnnotation": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
        },
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "panel_id": {
          "default": "panel:main",
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "ResolvedAnnotation",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "description": "An Electron-authorized resource reference, never a filesystem path.",
      "properties": {
        "resource_id": {
          "pattern": "^resource:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "authorized_file",
            "authorized_directory",
            "temporary_output"
          ],
          "title": "Resource Kind",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "resource_kind"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "SafeRichText": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/SafeTextNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "SafeRichText",
      "type": "object"
    },
    "SafeTextNode": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "kind": {
          "enum": [
            "plain",
            "newline",
            "sub",
            "sup",
            "bold",
            "italic",
            "fraction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SafeTextNode",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/origin-export-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Adapter Version",
      "type": "string"
    },
    "capability": {
      "const": "O1",
      "default": "O1",
      "title": "Capability",
      "type": "string"
    },
    "data_objects": {
      "items": {
        "$ref": "#/$defs/OriginDataObject"
      },
      "minItems": 1,
      "title": "Data Objects",
      "type": "array"
    },
    "export_spec_ref": {
      "$ref": "#/$defs/ExportSpecRef"
    },
    "graph_objects": {
      "items": {
        "$ref": "#/$defs/OriginGraphObject"
      },
      "minItems": 1,
      "title": "Graph Objects",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/OriginManifestPlan"
    },
    "origin_plan_id": {
      "pattern": "^originplan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Origin Plan Id",
      "type": "string"
    },
    "origin_plan_version": {
      "minimum": 1,
      "title": "Origin Plan Version",
      "type": "integer"
    },
    "origin_version": {
      "$ref": "#/$defs/OriginExactVersion"
    },
    "project_folders": {
      "const": "Data/Analysis/Graphs/Metadata",
      "default": "Data/Analysis/Graphs/Metadata",
      "title": "Project Folders",
      "type": "string"
    },
    "render_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Plan Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/OriginTemplateRef"
    },
    "validation": {
      "$ref": "#/$defs/OriginValidationPlan",
      "default": {
        "fresh_reopen_validation": true,
        "live_structural_validation": true,
        "require_atomic_publish": true,
        "require_no_external_links": true
      }
    }
  },
  "required": [
    "origin_plan_id",
    "origin_plan_version",
    "export_spec_ref",
    "render_plan_hash",
    "adapter_id",
    "adapter_version",
    "origin_version",
    "template",
    "data_objects",
    "graph_objects",
    "manifest"
  ],
  "title": "OriginExportPlan",
  "type": "object"
}
