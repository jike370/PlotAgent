{
  "$defs": {
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
    "ContentTableRef": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "object_hash",
        "row_count",
        "field_ids"
      ],
      "title": "ContentTableRef",
      "type": "object"
    },
    "ExportSpecRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "export_id": {
          "pattern": "^export:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Export Id",
          "type": "string"
        },
        "export_version": {
          "minimum": 1,
          "title": "Export Version",
          "type": "integer"
        }
      },
      "required": [
        "export_id",
        "export_version",
        "content_hash"
      ],
      "title": "ExportSpecRef",
      "type": "object"
    },
    "OriginBooleanProperty": {
      "additionalProperties": false,
      "properties": {
        "property_name": {
          "enum": [
            "axis.reverse",
            "legend.visible"
          ],
          "title": "Property Name",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        },
        "value_kind": {
          "const": "boolean",
          "default": "boolean",
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "property_name",
        "value"
      ],
      "title": "OriginBooleanProperty",
      "type": "object"
    },
    "OriginColorProperty": {
      "additionalProperties": false,
      "properties": {
        "property_name": {
          "const": "plot.color",
          "default": "plot.color",
          "title": "Property Name",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ColorValue"
        },
        "value_kind": {
          "const": "color",
          "default": "color",
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "value"
      ],
      "title": "OriginColorProperty",
      "type": "object"
    },
    "OriginDataObject": {
      "additionalProperties": false,
      "properties": {
        "data_ref": {
          "$ref": "#/$defs/ContentTableRef"
        },
        "folder": {
          "enum": [
            "Data",
            "Analysis"
          ],
          "title": "Folder",
          "type": "string"
        },
        "internal_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Internal Name",
          "type": "string"
        },
        "long_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Long Name",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "enum": [
            "worksheet",
            "matrixbook"
          ],
          "title": "Object Kind",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_kind",
        "folder",
        "internal_name",
        "long_name",
        "data_ref"
      ],
      "title": "OriginDataObject",
      "type": "object"
    },
    "OriginExactVersion": {
      "additionalProperties": false,
      "properties": {
        "bitness": {
          "const": "x64",
          "default": "x64",
          "title": "Bitness",
          "type": "string"
        },
        "build": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Build",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "build"
      ],
      "title": "OriginExactVersion",
      "type": "object"
    },
    "OriginGraphObject": {
      "additionalProperties": false,
      "properties": {
        "data_object_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Object Ids",
          "type": "array"
        },
        "folder": {
          "const": "Graphs",
          "default": "Graphs",
          "title": "Folder",
          "type": "string"
        },
        "graph_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Graph Id",
          "type": "string"
        },
        "internal_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Internal Name",
          "type": "string"
        },
        "layer_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Layer Ids",
          "type": "array"
        },
        "long_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Long Name",
          "type": "string"
        }
      },
      "required": [
        "graph_id",
        "internal_name",
        "long_name",
        "layer_ids",
        "data_object_ids"
      ],
      "title": "OriginGraphObject",
      "type": "object"
    },
    "OriginNumericProperty": {
      "additionalProperties": false,
      "properties": {
        "property_name": {
          "enum": [
            "page.width_mm",
            "page.height_mm",
            "layer.left_mm",
            "layer.top_mm",
            "layer.width_mm",
            "layer.height_mm",
            "axis.minimum",
            "axis.maximum",
            "plot.line_width_pt",
            "plot.marker_size_pt"
          ],
          "title": "Property Name",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "value_kind": {
          "const": "number",
          "default": "number",
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "property_name",
        "value"
      ],
      "title": "OriginNumericProperty",
      "type": "object"
    },
    "OriginScaleProperty": {
      "additionalProperties": false,
      "properties": {
        "property_name": {
          "const": "axis.scale",
          "default": "axis.scale",
          "title": "Property Name",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "value": {
          "enum": [
            "linear",
            "log10",
            "datetime",
            "categorical"
          ],
          "title": "Value",
          "type": "string"
        },
        "value_kind": {
          "const": "scale",
          "default": "scale",
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "value"
      ],
      "title": "OriginScaleProperty",
      "type": "object"
    },
    "OriginTemplateRef": {
      "additionalProperties": false,
      "properties": {
        "signature_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature Hash",
          "type": "string"
        },
        "template_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Hash",
          "type": "string"
        },
        "template_resource": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "template_resource",
        "template_hash",
        "signature_hash"
      ],
      "title": "OriginTemplateRef",
      "type": "object"
    },
    "OriginValidationPlan": {
      "additionalProperties": false,
      "properties": {
        "fresh_reopen_validation": {
          "const": true,
          "default": true,
          "title": "Fresh Reopen Validation",
          "type": "boolean"
        },
        "live_structural_validation": {
          "const": true,
          "default": true,
          "title": "Live Structural Validation",
          "type": "boolean"
        },
        "require_atomic_publish": {
          "const": true,
          "default": true,
          "title": "Require Atomic Publish",
          "type": "boolean"
        },
        "require_no_external_links": {
          "const": true,
          "default": true,
          "title": "Require No External Links",
          "type": "boolean"
        }
      },
      "title": "OriginValidationPlan",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "description": "An Electron-authorized resource reference, never a filesystem path.",
      "properties": {
        "resource_id": {
          "pattern": "^resource:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "authorized_file",
            "authorized_directory",
            "temporary_output"
          ],
          "title": "Resource Kind",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "resource_kind"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/origin-export-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Adapter Version",
      "type": "string"
    },
    "capability": {
      "const": "O1",
      "default": "O1",
      "title": "Capability",
      "type": "string"
    },
    "data_objects": {
      "items": {
        "$ref": "#/$defs/OriginDataObject"
      },
      "minItems": 1,
      "title": "Data Objects",
      "type": "array"
    },
    "export_spec_ref": {
      "$ref": "#/$defs/ExportSpecRef"
    },
    "graph_objects": {
      "items": {
        "$ref": "#/$defs/OriginGraphObject"
      },
      "minItems": 1,
      "title": "Graph Objects",
      "type": "array"
    },
    "origin_plan_id": {
      "pattern": "^originplan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Origin Plan Id",
      "type": "string"
    },
    "origin_plan_version": {
      "minimum": 1,
      "title": "Origin Plan Version",
      "type": "integer"
    },
    "origin_version": {
      "$ref": "#/$defs/OriginExactVersion"
    },
    "project_folders": {
      "const": "Data/Analysis/Graphs/Metadata",
      "default": "Data/Analysis/Graphs/Metadata",
      "title": "Project Folders",
      "type": "string"
    },
    "property_assignments": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "boolean": "#/$defs/OriginBooleanProperty",
            "color": "#/$defs/OriginColorProperty",
            "number": "#/$defs/OriginNumericProperty",
            "scale": "#/$defs/OriginScaleProperty"
          },
          "propertyName": "value_kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OriginNumericProperty"
          },
          {
            "$ref": "#/$defs/OriginBooleanProperty"
          },
          {
            "$ref": "#/$defs/OriginScaleProperty"
          },
          {
            "$ref": "#/$defs/OriginColorProperty"
          }
        ]
      },
      "title": "Property Assignments",
      "type": "array"
    },
    "render_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Plan Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/OriginTemplateRef"
    },
    "validation": {
      "$ref": "#/$defs/OriginValidationPlan",
      "default": {
        "fresh_reopen_validation": true,
        "live_structural_validation": true,
        "require_atomic_publish": true,
        "require_no_external_links": true
      }
    }
  },
  "required": [
    "origin_plan_id",
    "origin_plan_version",
    "export_spec_ref",
    "render_plan_hash",
    "adapter_id",
    "adapter_version",
    "origin_version",
    "template",
    "data_objects",
    "graph_objects"
  ],
  "title": "OriginExportPlan",
  "type": "object"
}
