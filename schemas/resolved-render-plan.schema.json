  "required": [
    "render_plan_id",
    "render_plan_version",
    "resolver_version",
    "source_refs",
    "source_content_hashes",
    "quality_tier",
    "canvas",
    "panels",
    "axes",
    "layers",
    "fonts",
    "data_integrity"
  ],
  "title": "ResolvedRenderPlan",
  "type": "object"
