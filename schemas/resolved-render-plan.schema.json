{
  "$defs": {
    "ColorValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ColorValue",
      "type": "object"
    },
    "ContentTableRef": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "object_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Hash",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "object_hash",
        "row_count",
        "field_ids"
      ],
      "title": "ContentTableRef",
      "type": "object"
    },
    "DataIntegritySnapshot": {
      "additionalProperties": false,
      "properties": {
        "excluded_rows": {
          "minimum": 0,
          "title": "Excluded Rows",
          "type": "integer"
        },
        "full_data_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Full Data Hash",
          "type": "string"
        },
        "nonfinite_values": {
          "minimum": 0,
          "title": "Nonfinite Values",
          "type": "integer"
        },
        "simplification_applied": {
          "title": "Simplification Applied",
          "type": "boolean"
        },
        "total_rows": {
          "minimum": 0,
          "title": "Total Rows",
          "type": "integer"
        },
        "visible_rows": {
          "minimum": 0,
          "title": "Visible Rows",
          "type": "integer"
        }
      },
      "required": [
        "total_rows",
        "visible_rows",
        "excluded_rows",
        "nonfinite_values",
        "simplification_applied",
        "full_data_hash"
      ],
      "title": "DataIntegritySnapshot",
      "type": "object"
    },
    "ObjectVersionRef": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "object_id": {
          "pattern": "^(source|mapping|preparation|prepared|plotcalc|plot|batch|figure|export|renderplan|originplan|plan|project):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "expected_version"
      ],
      "title": "ObjectVersionRef",
      "type": "object"
    },
    "PhysicalLength": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "pt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "PhysicalLength",
      "type": "object"
    },
    "PhysicalSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "width": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "PhysicalSize",
      "type": "object"
    },
    "ResolvedAnnotation": {
      "additionalProperties": false,
      "properties": {
        "affect_range": {
          "default": false,
          "title": "Affect Range",
          "type": "boolean"
        },
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "arrow",
            "line",
            "rectangle",
            "reference_line",
            "reference_band",
            "peak_label",
            "significance_bracket",
            "panel_label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "panel_id": {
          "default": "panel:main",
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X2"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        }
      },
      "required": [
        "annotation_id",
        "kind"
      ],
      "title": "ResolvedAnnotation",
      "type": "object"
    },
    "ResolvedAxis": {
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "pattern": "^axis:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Axis Id",
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/ColorValue",
          "default": {
            "value": "#000000"
          }
        },
        "cross_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross At"
        },
        "exponent": {
          "default": 0,
          "title": "Exponent",
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/SafeRichText"
        },
        "line_width": {
          "$ref": "#/$defs/PhysicalLength",
          "default": {
            "unit": "pt",
            "value": 0.8
          }
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "orientation": {
          "default": "x",
          "enum": [
            "x",
            "y",
            "color"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "panel_id": {
          "default": "panel:main",
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "top",
            "left",
            "right",
            "none"
          ],
          "title": "Position",
          "type": "string"
        },
        "precision": {
          "default": 0,
          "minimum": 0,
          "title": "Precision",
          "type": "integer"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
        "scale": {
          "enum": [
            "linear",
            "log10",
            "datetime",
            "categorical"
          ],
          "title": "Scale",
          "type": "string"
        },
        "ticks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResolvedTick"
          },
          "title": "Ticks",
          "type": "array"
        }
      },
      "required": [
        "axis_id",
        "scale",
        "label"
      ],
      "title": "ResolvedAxis",
      "type": "object"
    },
    "ResolvedColorbar": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "default": 7,
          "maximum": 64,
          "minimum": 2,
          "title": "Levels",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "title": "ResolvedColorbar",
      "type": "object"
    },
    "ResolvedFieldBinding": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "field_id"
      ],
      "title": "ResolvedFieldBinding",
      "type": "object"
    },
    "ResolvedFont": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "file_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Hash",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "family",
        "file_hash",
        "size"
      ],
      "title": "ResolvedFont",
      "type": "object"
    },
    "ResolvedLayer": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Alpha",
          "type": "number"
        },
        "band_alpha": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Band Alpha",
          "type": "number"
        },
        "cap_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalLength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Maximum"
        },
        "color_minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Minimum"
        },
        "data_ref": {
          "$ref": "#/$defs/ContentTableRef"
        },
        "data_source_kind": {
          "default": "direct",
          "enum": [
            "direct",
            "fixed",
            "user_precomputed",
            "panel_plan"
          ],
          "title": "Data Source Kind",
          "type": "string"
        },
        "displayed_row_count": {
          "default": 0,
          "minimum": 0,
          "title": "Displayed Row Count",
          "type": "integer"
        },
        "edge_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_width": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalLength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResolvedFieldBinding"
          },
          "title": "Field Bindings",
          "type": "array"
        },
        "field_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "fill_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "full_row_count": {
          "default": 0,
          "minimum": 0,
          "title": "Full Row Count",
          "type": "integer"
        },
        "geometry": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Geometry",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Layer Id",
          "type": "string"
        },
        "levels": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Levels",
          "type": "array"
        },
        "line_style": {
          "default": "solid",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dash_dot"
          ],
          "title": "Line Style",
          "type": "string"
        },
        "line_width": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalLength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marker_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalLength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "palette": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ColorValue"
          },
          "title": "Palette",
          "type": "array"
        },
        "palette_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedPalette"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "panel_id": {
          "default": "panel:main",
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "step_where": {
          "default": "post",
          "enum": [
            "pre",
            "mid",
            "post"
          ],
          "title": "Step Where",
          "type": "string"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolStyle",
          "default": {
            "interior": "solid",
            "shape": "circle"
          }
        },
        "target_id": {
          "pattern": "^(plot|series|axis|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "uncertainty_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uncertainty_line_width": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalLength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width_ratio": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width Ratio",
          "type": "number"
        },
        "z_order": {
          "title": "Z Order",
          "type": "integer"
        }
      },
      "required": [
        "layer_id",
        "target_id",
        "geometry",
        "data_ref",
        "field_ids",
        "z_order"
      ],
      "title": "ResolvedLayer",
      "type": "object"
    },
    "ResolvedLegend": {
      "additionalProperties": false,
      "properties": {
        "anchor_x": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Y",
          "type": "number"
        },
        "common": {
          "default": false,
          "title": "Common",
          "type": "boolean"
        },
        "placement": {
          "default": "inside",
          "enum": [
            "inside",
            "outside_right",
            "outside_bottom"
          ],
          "title": "Placement",
          "type": "string"
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "title": "ResolvedLegend",
      "type": "object"
    },
    "ResolvedPalette": {
      "additionalProperties": false,
      "properties": {
        "colors": {
          "items": {
            "$ref": "#/$defs/ColorValue"
          },
          "minItems": 2,
          "title": "Colors",
          "type": "array"
        },
        "kind": {
          "enum": [
            "qualitative",
            "sequential",
            "diverging",
            "special",
            "grayscale"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin_asset_kind": {
          "enum": [
            "color_list",
            "palette"
          ],
          "title": "Origin Asset Kind",
          "type": "string"
        },
        "origin_source_name": {
          "title": "Origin Source Name",
          "type": "string"
        },
        "palette_id": {
          "enum": [
            "ColorBlindSafe8",
            "ColorBlindSafe15",
            "BlueOrange",
            "OrangeNavy",
            "RedPurple",
            "Viridis",
            "Plasma",
            "Inferno",
            "Magma",
            "GreyBlue",
            "YellowBlue",
            "YellowGreen",
            "YellowPurple",
            "Fire",
            "Rainbow_Modified",
            "GrayScale"
          ],
          "title": "Palette Id",
          "type": "string"
        },
        "resolved_rgb_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Rgb Hash",
          "type": "string"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_version": {
          "const": "Origin2024 SR1 10.10.178",
          "default": "Origin2024 SR1 10.10.178",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "palette_id",
        "origin_source_name",
        "origin_asset_kind",
        "kind",
        "colors",
        "source_hash",
        "resolved_rgb_hash"
      ],
      "title": "ResolvedPalette",
      "type": "object"
    },
    "ResolvedPanel": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeRichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "left": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "panel_id": {
          "pattern": "^panel:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Panel Id",
          "type": "string"
        },
        "top": {
          "$ref": "#/$defs/PhysicalLength"
        },
        "width": {
          "$ref": "#/$defs/PhysicalLength"
        }
      },
      "required": [
        "panel_id",
        "left",
        "top",
        "width",
        "height"
      ],
      "title": "ResolvedPanel",
      "type": "object"
    },
    "ResolvedTick": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/SafeRichText"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ResolvedTick",
      "type": "object"
    },
    "SafeRichText": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/SafeTextNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "SafeRichText",
      "type": "object"
    },
    "SafeTextNode": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "kind": {
          "enum": [
            "plain",
            "newline",
            "sub",
            "sup",
            "bold",
            "italic",
            "fraction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SafeTextNode",
      "type": "object"
    },
    "SymbolStyle": {
      "additionalProperties": false,
      "properties": {
        "interior": {
          "default": "solid",
          "enum": [
            "solid",
            "open",
            "hollow"
          ],
          "title": "Interior",
          "type": "string"
        },
        "shape": {
          "default": "circle",
          "enum": [
            "square",
            "circle",
            "triangle_up",
            "triangle_down",
            "diamond",
            "plus",
            "cross",
            "triangle_left",
            "triangle_right",
            "hexagon",
            "star",
            "pentagon"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "title": "SymbolStyle",
      "type": "object"
    },
    "WarningRecord": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "warning_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Warning Id",
          "type": "string"
        }
      },
      "required": [
        "warning_id",
        "message"
      ],
      "title": "WarningRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v1/resolved-render-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "axes": {
      "items": {
        "$ref": "#/$defs/ResolvedAxis"
      },
      "minItems": 1,
      "title": "Axes",
      "type": "array"
    },
    "background": {
      "$ref": "#/$defs/ColorValue",
      "default": {
        "value": "#FFFFFF"
      }
    },
    "canvas": {
      "$ref": "#/$defs/PhysicalSize"
    },
    "chart_type_id": {
      "anyOf": [
        {
          "enum": [
            "K01",
            "K02",
            "K03",
            "K04",
            "K05",
            "K06",
            "K07",
            "K08",
            "K09",
            "K10",
            "K11",
            "K12",
            "K13",
            "K14",
            "K15",
            "K16",
            "K17",
            "K18",
            "K19",
            "K20",
            "K21",
            "K22",
            "K24",
            "K25",
            "S01",
            "S05",
            "S21",
            "S25",
            "S31",
            "S34",
            "S61",
            "X01",
            "X02",
            "X03",
            "X05",
            "X07",
            "X09",
            "X11",
            "X12",
            "X13",
            "X15",
            "X16",
            "X17",
            "X18",
            "X19",
            "X23",
            "X24",
            "X35",
            "X36",
            "X37",
            "X38",
            "S07"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chart Type Id"
    },
    "color_space": {
      "const": "sRGB",
      "default": "sRGB",
      "title": "Color Space",
      "type": "string"
    },
    "colorbar": {
      "$ref": "#/$defs/ResolvedColorbar",
      "default": {
        "levels": 7,
        "maximum": null,
        "minimum": null,
        "title": null,
        "visible": false
      }
    },
    "data_integrity": {
      "$ref": "#/$defs/DataIntegritySnapshot"
    },
    "dpi": {
      "default": 300,
      "maximum": 2400,
      "minimum": 72,
      "title": "Dpi",
      "type": "integer"
    },
    "fonts": {
      "items": {
        "$ref": "#/$defs/ResolvedFont"
      },
      "minItems": 1,
      "title": "Fonts",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/ResolvedLayer"
      },
      "minItems": 1,
      "title": "Layers",
      "type": "array"
    },
    "legend": {
      "$ref": "#/$defs/ResolvedLegend",
      "default": {
        "anchor_x": 1.0,
        "anchor_y": 1.0,
        "common": false,
        "placement": "inside",
        "visible": false
      }
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/ResolvedPanel"
      },
      "minItems": 1,
      "title": "Panels",
      "type": "array"
    },
    "quality_tier": {
      "enum": [
        "thumbnail",
        "interactive",
        "formal"
      ],
      "title": "Quality Tier",
      "type": "string"
