    "render_plan_id": {
      "pattern": "^renderplan:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Render Plan Id",
      "type": "string"
    },
    "render_plan_version": {
      "minimum": 1,
      "title": "Render Plan Version",
      "type": "integer"
    },
    "resolver_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Resolver Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_content_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Content Hashes",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/ObjectVersionRef"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "svg_text_mode": {
      "default": "text_to_path",
      "enum": [
        "text_to_path",
        "editable_text"
      ],
      "title": "Svg Text Mode",
