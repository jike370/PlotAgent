{
  "$defs": {
    "CalculationTable": {
      "additionalProperties": false,
      "description": "Self-contained renderer geometry with a content-addressed strict shape.",
      "properties": {
        "field_ids": {
          "items": {
            "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "field_ids",
        "rows"
      ],
      "title": "CalculationTable",
      "type": "object"
    },
    "ConfusionCountResult": {
      "additionalProperties": false,
      "properties": {
        "algorithm_id": {
          "const": "fixed_confusion_count",
          "default": "fixed_confusion_count",
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Algorithm Version",
          "type": "string"
        },
        "calculation_id": {
          "pattern": "^plotcalc:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Calculation Id",
          "type": "string"
        },
        "category_count": {
          "minimum": 1,
          "title": "Category Count",
          "type": "integer"
        },
        "category_order": {
          "items": {
            "type": "string"
          },
          "title": "Category Order",
          "type": "array"
        },
        "excluded_row_count": {
          "minimum": 0,
          "title": "Excluded Row Count",
          "type": "integer"
        },
        "exclusions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RowExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "fixed_seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Seed"
        },
        "included_row_count": {
          "minimum": 0,
          "title": "Included Row Count",
          "type": "integer"
        },
        "included_row_ids": {
          "items": {
            "pattern": "^row:[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
            "type": "string"
          },
          "title": "Included Row Ids",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "const": "confusion_count",
          "default": "confusion_count",
          "title": "Kind",
          "type": "string"
        },
        "missing_policy": {
          "enum": [
            "fail",
            "exclude_with_report"
          ],
          "title": "Missing Policy",
          "type": "string"
        },
        "nonfinite_counts": {
          "$ref": "#/$defs/NonFiniteCounts",
          "default": {
            "missing": 0,
            "nan": 0,
            "negative_inf": 0,
            "positive_inf": 0
          }
        },
        "normalization": {
          "enum": [
            "count",
            "true_class",
            "predicted_class"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "output_data_ref": {
          "$ref": "#/$defs/ContentTableRef"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "output_table": {
          "$ref": "#/$defs/CalculationTable"
        },
        "prepared_dataset_ref": {
          "$ref": "#/$defs/PreparedDatasetRef"
        },
        "producer_build_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Build Hash",
          "type": "string"
        },
        "result_version": {
          "minimum": 1,
          "title": "Result Version",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_ref": {
          "$ref": "#/$defs/PlotCalculationSpecRef"
        },
        "total_row_count": {
          "minimum": 0,
          "title": "Total Row Count",
          "type": "integer"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WarningRecord"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "calculation_id",
        "result_version",
        "spec_ref",
        "prepared_dataset_ref",
        "algorithm_version",
        "missing_policy",
        "input_hash",
        "output_hash",
        "output_data_ref",
        "output_table",
        "total_row_count",
        "included_row_count",
        "excluded_row_count",
        "included_row_ids",
        "producer_build_hash",
        "normalization",
        "category_count",
        "category_order"
