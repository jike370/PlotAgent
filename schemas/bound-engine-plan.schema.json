{
  "$defs": {
    "AddAnnotation": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "annotation_id": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "coordinate_system": {
          "default": "data",
          "enum": [
            "data",
            "axes",
            "page"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "add_annotation",
          "default": "add_annotation",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "annotation_id",
        "text",
        "x",
        "y"
      ],
      "title": "AddAnnotation",
      "type": "object"
    },
    "BindFields": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/FieldBinding"
          },
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "data": {
          "$ref": "#/$defs/EngineDataRef"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "bind_fields",
          "default": "bind_fields",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "data",
        "bindings"
      ],
      "title": "BindFields",
      "type": "object"
    },
    "CreatePlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlotDocumentRef"
          },
          "maxItems": 4,
          "title": "Components",
          "type": "array"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineDataRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "const": "create_plot",
          "default": "create_plot",
          "title": "Operation",
          "type": "string"
        },
        "plot_id": {
          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plot_id",
        "profile_id"
      ],
      "title": "CreatePlot",
      "type": "object"
    },
    "EngineDataRef": {
      "additionalProperties": false,
      "description": "Immutable data revision consumed by a plot document.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "prepared",
            "calculated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "version",
        "content_hash"
      ],
      "title": "EngineDataRef",
      "type": "object"
    },
    "ExportPlot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "format": {
          "enum": [
            "png",
            "svg",
            "opju"
          ],
          "title": "Format",
          "type": "string"
        },
        "operation": {
          "const": "export_plot",
          "default": "export_plot",
          "title": "Operation",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[^\\\\/:*?\\\"<>|\\r\\n]{1,120}$",
          "title": "Output Name",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "format",
        "output_name"
      ],
      "title": "ExportPlot",
      "type": "object"
    },
    "FieldBinding": {
      "additionalProperties": false,
      "description": "Semantic chart role bound to one immutable field.",
      "properties": {
        "field_id": {
          "pattern": "^field:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "field_id"
      ],
      "title": "FieldBinding",
      "type": "object"
    },
    "PlotDocumentRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "plot_id": {
          "pattern": "^plot:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Plot Id",
          "type": "string"
        },
        "plot_version": {
          "minimum": 1,
          "title": "Plot Version",
          "type": "integer"
        }
      },
      "required": [
        "plot_id",
        "plot_version",
        "content_hash"
      ],
      "title": "PlotDocumentRef",
      "type": "object"
    },
    "SetAxis": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "operation": {
          "const": "set_axis",
          "default": "set_axis",
          "title": "Operation",
          "type": "string"
        },
        "reverse": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reverse"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "log10",
                "datetime",
                "categorical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target"
      ],
      "title": "SetAxis",
      "type": "object"
    },
    "SetChartParameter": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "set_chart_parameter",
          "default": "set_chart_parameter",
          "title": "Operation",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Parameter",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "parameter",
        "value"
      ],
      "title": "SetChartParameter",
      "type": "object"
    },
    "SetLegend": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "enum": [
                "inside",
                "right",
                "bottom",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "set_legend",
          "default": "set_legend",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target"
      ],
      "title": "SetLegend",
      "type": "object"
    },
    "SetSeriesStyle": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "line_style": {
          "anyOf": [
            {
              "enum": [
                "solid",
                "dash",
                "dot",
                "dash_dot",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Style"
        },
        "line_width_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Width Pt"
        },
        "operation": {
          "const": "set_series_style",
          "default": "set_series_style",
          "title": "Operation",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "symbol_size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 72,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol Size Pt"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target"
      ],
      "title": "SetSeriesStyle",
      "type": "object"
    },
    "SetTitle": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_plot_version": {
          "minimum": 1,
          "title": "Expected Plot Version",
          "type": "integer"
        },
        "operation": {
          "const": "set_title",
          "default": "set_title",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "pattern": "^(plot|axis|series|legend|annotation|panel):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "expected_plot_version",
        "action_id",
        "target",
        "text"
      ],
      "title": "SetTitle",
      "type": "object"
    }
  },
  "$id": "https://schemas.plotagent.local/v2/bound-engine-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_annotation": "#/$defs/AddAnnotation",
            "bind_fields": "#/$defs/BindFields",
            "create_plot": "#/$defs/CreatePlot",
            "export_plot": "#/$defs/ExportPlot",
            "set_axis": "#/$defs/SetAxis",
            "set_chart_parameter": "#/$defs/SetChartParameter",
            "set_legend": "#/$defs/SetLegend",
            "set_series_style": "#/$defs/SetSeriesStyle",
            "set_title": "#/$defs/SetTitle"
          },
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CreatePlot"
          },
          {
            "$ref": "#/$defs/BindFields"
          },
          {
            "$ref": "#/$defs/SetTitle"
          },
          {
            "$ref": "#/$defs/SetAxis"
          },
          {
            "$ref": "#/$defs/SetSeriesStyle"
          },
          {
            "$ref": "#/$defs/SetLegend"
          },
          {
            "$ref": "#/$defs/SetChartParameter"
          },
          {
            "$ref": "#/$defs/AddAnnotation"
          },
          {
            "$ref": "#/$defs/ExportPlot"
          }
        ]
      },
      "title": "Actions",
      "type": "array"
    },
    "expected_project_revision": {
      "title": "Expected Project Revision",
      "type": "integer"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "expected_project_revision",
    "actions"
  ],
  "title": "BoundEnginePlan",
  "type": "object"
}
